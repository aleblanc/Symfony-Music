{% extends 'base.html.twig' %}

{% block title %}{{ 'duplicates.index.heading'|trans }} · PHP Music{% endblock %}

{% set kinds = {
    same_file: {label: 'duplicates.kind.same_file.label', hint: 'duplicates.kind.same_file.hint'},
    same_album: {label: 'duplicates.kind.same_album.label', hint: 'duplicates.kind.same_album.hint'},
    other_album: {label: 'duplicates.kind.other_album.label', hint: 'duplicates.kind.other_album.hint'},
} %}

{% block body %}
<div class="quality-stats duplicates">
    <h1>{{ 'duplicates.index.heading'|trans }}</h1>
    <p class="section-sub">
        {{ 'duplicates.index.summary'|trans({count: groups|length}) }}
        {{ 'duplicates.index.explain_html'|trans({trash: trashDir|e})|raw }}
    </p>

    {% for kind, info in kinds %}
        {% set list = groups|filter(g => g.kind == kind) %}
        <section class="qs-block" id="{{ kind }}">
            <h2>{{ info.label|trans }} <span class="muted">{{ 'duplicates.index.groups'|trans({count: list|length}) }}</span></h2>
            <p class="muted qs-note">{{ info.hint|trans }}</p>
            {% if list is empty %}
                <p class="muted">{{ 'common.none'|trans }}</p>
            {% endif %}
            {% for group in list %}
                {% set anchor = 'g' ~ group.tracks[0].id %}
                <table class="qs-tracks dup-group" id="{{ anchor }}">
                    <thead><tr><th>{{ 'duplicates.index.col_quality'|trans }}</th><th>{{ 'duplicates.index.col_title'|trans }}</th><th>{{ 'duplicates.index.col_album'|trans }}</th><th>{{ 'duplicates.index.col_length'|trans }}</th><th>{{ 'duplicates.index.col_used'|trans }}</th><th>{{ 'duplicates.index.col_file'|trans }}</th><th></th></tr></thead>
                    <tbody>
                        {% for t in group.tracks %}
                            <tr class="{{ t.id == group.keep ? 'dup-best' }}">
                                <td class="qs-num">
                                    {{ t.format }} {% if t.bitrate %}{{ 'quality.index.kbps'|trans({value: (t.bitrate / 1000)|round}) }}{% endif %}
                                    {% if t.quality %}<span class="quality-badge quality-{{ t.quality.value }}">{{ t.quality.label|trans }}</span>{% endif %}
                                    {% if t.effectiveKbps %}<div class="q-inflated-note">{{ 'duplicates.index.inflated'|trans({real: t.effectiveKbps}) }}</div>{% endif %}
                                    {% if t.cutoffHz %}<div class="muted" title="{{ 'duplicates.index.cutoff_title'|trans }}">↑ {{ 'song.show.khz'|trans({value: (t.cutoffHz / 100)|round / 10}) }}</div>{% endif %}
                                </td>
                                <td><a class="link" href="{{ path('app_song', {id: t.id}) }}">{{ t.title ?: t.file|split('/')|last }}</a><br><span class="muted">{{ t.artist }}</span></td>
                                <td class="muted">{{ t.album }}{% if t.year %} ({{ t.year }}){% endif %}</td>
                                <td class="qs-num">{{ (t.duration // 60) }}:{{ '%02d'|format(t.duration % 60) }}</td>
                                <td class="qs-num">
                                    {% if t.favorites %}♥ {{ t.favorites }} {% endif %}
                                    {% if t.plays %}▶ {{ t.plays }} {% endif %}
                                    {% if t.playlists %}☰ {{ t.playlists }}{% endif %}
                                </td>
                                <td class="dup-file">{{ t.relative }}{% if not t.exists %} <span class="pill-count pill-warn">{{ 'duplicates.index.file_missing'|trans }}</span>{% endif %}</td>
                                <td>
                                    <form method="post" action="{{ path('app_duplicates_keep', {id: t.id}) }}"
                                          onsubmit="return confirm('{{ 'duplicates.index.confirm_keep'|trans({count: group.tracks|length - 1})|e('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('duplicates_keep_' ~ t.id) }}">
                                        <input type="hidden" name="next" value="{{ anchor }}">
                                        {% for other in group.tracks|filter(o => o.id != t.id) %}
                                            <input type="hidden" name="drop[]" value="{{ other.id }}">
                                        {% endfor %}
                                        <button class="btn btn-sm {{ t.id == group.keep ? '' : 'btn-ghost' }}" type="submit" title="{{ t.id == group.keep ? 'duplicates.index.suggested_title'|trans : '' }}">{{ 'duplicates.index.keep'|trans }}</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endfor %}
        </section>
    {% endfor %}
</div>
{% endblock %}
