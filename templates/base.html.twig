<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}PHP Music (Symfony){% endblock %}</title>
        <link rel="icon" type="image/svg+xml" href="/icon.svg">
        <link rel="manifest" href="/manifest.json">
        <meta name="theme-color" content="#0a0a0a">
        <link rel="stylesheet" href="/app.css">
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <div class="app-shell">
            {% import 'partials/_icons.html.twig' as icons %}
            {% set route = app.request.attributes.get('_route') %}
            <aside class="sidebar">
                <div class="brand"><a href="{{ path('app_home') }}"><span class="brand-mark">♪</span> PHP&nbsp;Music</a></div>
                <nav>
                    <a href="{{ path('app_home') }}" class="{{ route == 'app_home' ? 'active' }}">{{ icons.icon('home') }}<span>{{ 'nav.home'|trans }}</span></a>
                    <a href="{{ path('app_library') }}" class="{{ route == 'app_library' ? 'active' }}">{{ icons.icon('library') }}<span>{{ 'nav.library'|trans }}</span></a>
                    <a href="{{ path('app_artists') }}" class="{{ route starts with 'app_artist' ? 'active' }}">{{ icons.icon('artist') }}<span>{{ 'nav.artists'|trans }}</span></a>
                    <a href="{{ path('app_videos') }}" class="{{ route == 'app_videos' ? 'active' }}">{{ icons.icon('video') }}<span>{{ 'nav.new_videos'|trans }}</span></a>
                    <a href="{{ path('app_posts') }}" class="{{ route == 'app_posts' ? 'active' }}">{{ icons.icon('photo') }}<span>{{ 'nav.new_posts'|trans }}</span></a>
                    <a href="{{ path('app_concerts') }}" class="{{ route == 'app_concerts' ? 'active' }}">{{ icons.icon('ticket') }}<span>{{ 'nav.concerts'|trans }}</span></a>
                    <a href="{{ path('app_genres') }}" class="{{ route starts with 'app_genre' ? 'active' }}">{{ icons.icon('genre') }}<span>{{ 'nav.genres'|trans }}</span></a>
                    <a href="{{ path('app_years') }}" class="{{ route starts with 'app_year' ? 'active' }}">{{ icons.icon('year') }}<span>{{ 'nav.years'|trans }}</span></a>
                    <a href="{{ path('app_discover') }}" class="{{ route starts with 'app_discover' or route == 'app_mix_show' ? 'active' }}">{{ icons.icon('discover') }}<span>{{ 'nav.discover'|trans }}</span></a>
                    <a href="{{ path('app_folder', {name: 'discover'}) }}" class="{{ route == 'app_folder' and app.request.attributes.get('name') == 'discover' ? 'active' }}">{{ icons.icon('folder') }}<span>{{ 'nav.discover_folder'|trans }}</span></a>
                    <a href="{{ path('app_folder', {name: 'unclassified'}) }}" class="{{ route == 'app_folder' and app.request.attributes.get('name') == 'unclassified' ? 'active' }}">{{ icons.icon('folder') }}<span>{{ 'nav.unclassified_folder'|trans }}</span></a>
                    {% if app.user %}
                        <div class="nav-label">{{ 'nav.your_music'|trans }}</div>
                        <a href="{{ path('app_favorites') }}" class="{{ route == 'app_favorites' ? 'active' }}">{{ icons.icon('heart') }}<span>{{ 'nav.favorites'|trans }}</span></a>
                        <a href="{{ path('app_album_favorites') }}" class="{{ route == 'app_album_favorites' ? 'active' }}">{{ icons.icon('heart') }}<span>{{ 'nav.favorite_discography'|trans }}</span></a>
                        <a href="{{ path('app_ratings') }}" class="{{ route == 'app_ratings' ? 'active' }}">{{ icons.icon('star') }}<span>{{ 'nav.ratings'|trans }}</span></a>
                        <a href="{{ path('app_listen_later') }}" class="{{ route starts with 'app_listen_later' ? 'active' }}">{{ icons.icon('clock') }}<span>{{ 'nav.listen_later'|trans }}</span></a>
                        <a href="{{ path('app_offline') }}" class="{{ route starts with 'app_offline' ? 'active' }}">{{ icons.icon('cloud') }}<span>{{ 'nav.offline'|trans }}</span></a>
                        <a href="{{ path('app_playlists') }}" class="{{ route starts with 'app_playlist' ? 'active' }}">{{ icons.icon('playlist') }}<span>{{ 'nav.playlists'|trans }}</span></a>
                        {# The rhythm game is a standalone full-screen app: open it in its own
                           tab (target=_blank, which nav.js ignores) so the main tab keeps its
                           shell and the music playing. #}
                        <a href="{{ path('app_rhythm') }}" target="_blank" rel="noopener" title="{{ 'nav.rhythm_title'|trans }}">{{ icons.icon('game') }}<span>{{ 'nav.rhythm'|trans }}</span></a>
                        <a href="{{ path('app_upload') }}" class="{{ route starts with 'app_upload' ? 'active' }}">{{ icons.icon('upload') }}<span>{{ 'nav.upload'|trans }}</span></a>
                    {% endif %}
                </nav>
                <div class="sidebar-footer">
                    {% if app.user %}
                        <div class="me">
                            <span class="avatar">{{ (app.user.artist ?? '?')|slice(0, 1)|upper }}</span>
                            <span class="me-name">{{ app.user.artist }}</span>
                        </div>
                        <a href="{{ path('app_logout') }}" class="btn-link">{{ icons.icon('logout') }}<span>{{ 'nav.log_out'|trans }}</span></a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn-link">{{ 'nav.log_in'|trans }}</a>
                        <a href="{{ path('app_register') }}" class="btn-link">{{ 'nav.sign_up'|trans }}</a>
                    {% endif %}
                    {# Full reload (data-no-nav): the sidebar, the player and the
                       i18n-config of the scripts must all switch language. #}
                    <form class="lang-switch" method="post" data-no-nav aria-label="{{ 'nav.language'|trans }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('locale_switch') }}">
                        {% for l in app.enabled_locales %}
                            <button type="submit" formaction="{{ path('app_locale_switch', {locale: l}) }}" lang="{{ l }}"{% if l == app.request.locale %} aria-current="true"{% endif %}>{{ l|upper }}</button>
                        {% endfor %}
                    </form>
                </div>
            </aside>

            <main class="content">
                {# Global search, rendered inside <main> so nav.js partial swaps
                   keep the field's value in sync with the current page. #}
                <div class="topbar">
                    <form class="global-search" role="search" method="get" action="{{ path('app_library') }}">
                        {{ icons.icon('search') }}
                        <input type="search" id="global-search" name="q"
                               value="{{ route == 'app_library' ? app.request.query.get('q') }}"
                               placeholder="{{ 'search.placeholder'|trans }}" aria-label="{{ 'search.aria_label'|trans }}" autocomplete="off">
                        <kbd>/</kbd>
                    </form>
                    {% if is_granted('ROLE_ADMIN') %}
                        <nav class="topbar-admin" aria-label="{{ 'admin_nav.aria_label'|trans }}">
                            <a href="{{ path('app_import_queue') }}" class="{{ route starts with 'app_import' ? 'active' }}" title="{{ 'admin_nav.import_queue_title'|trans }}">{{ 'admin_nav.import_queue'|trans }}</a>
                            <a href="{{ path('app_quality_stats') }}" class="{{ route == 'app_quality_stats' ? 'active' }}" title="{{ 'admin_nav.audio_quality_title'|trans }}">{{ 'admin_nav.audio_quality'|trans }}</a>
                            <a href="{{ path('app_duplicates') }}" class="{{ route == 'app_duplicates' ? 'active' }}" title="{{ 'admin_nav.duplicates_title'|trans }}">{{ 'admin_nav.duplicates'|trans }}</a>
                        </nav>
                    {% endif %}
                </div>
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash flash-{{ label }}">{{ message|trans }}</div>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>

        {# Persistent player bar, controlled by assets/player.js #}
        <footer class="player" id="player" hidden>
            <div class="player-meta">
                <img id="player-cover" alt="" width="48" height="48">
                <div>
                    <a id="player-title" class="player-title" href="#" title="{{ 'player.track_details'|trans }}"></a>
                    <div class="player-artist">
                        <a id="player-artist" href="#" title="{{ 'player.artist'|trans }}"></a><span id="player-album-sep" hidden> · </span><a id="player-album" href="#" title="{{ 'player.album'|trans }}" hidden></a>
                    </div>
                    {# Rating of the playing track, filled by player.js #}
                    {% if app.user %}<span id="player-rate" class="rate player-rate" role="radiogroup" aria-label="{{ 'common.rating'|trans }}" hidden></span>{% endif %}
                </div>
            </div>
            <div class="player-controls">
                <div class="buttons">
                    <button id="player-prev" title="{{ 'common.previous'|trans }}" aria-label="{{ 'common.previous'|trans }}">⏮</button>
                    <button id="player-toggle" title="{{ 'player.play_pause'|trans }}" aria-label="{{ 'player.play_pause'|trans }}">▶</button>
                    <button id="player-next" title="{{ 'common.next'|trans }}" aria-label="{{ 'common.next'|trans }}">⏭</button>
                    <button id="player-lyrics" class="player-lyrics-btn" title="{{ 'player.lyrics_title'|trans }}" aria-label="{{ 'player.lyrics'|trans }}" aria-expanded="false" aria-controls="lyrics-panel">
                        <svg viewBox="0 0 24 24"><path d="M3 5h12v2H3zm0 4h12v2H3zm0 4h8v2H3zm15-8v9.18A3 3 0 1020 17V7h3V5z"/></svg>
                    </button>
                    <button id="player-queue" class="player-queue-btn" title="{{ 'player.queue_title'|trans }}" aria-label="{{ 'player.queue'|trans }}" aria-expanded="false" aria-controls="queue-panel">
                        <svg viewBox="0 0 24 24"><path d="M3 10h11v2H3zm0-4h11v2H3zm0 8h7v2H3zm13-1v8l6-4z"/></svg>
                    </button>
                </div>
                <div class="progress">
                    <span id="player-current">0:00</span>
                    <input type="range" id="player-seek" min="0" max="100" value="0">
                    <span id="player-duration">0:00</span>
                </div>
            </div>
            <div class="player-volume">
                <button id="player-pip" class="pip-btn" title="{{ 'player.pip_title'|trans }}" aria-label="{{ 'player.pip'|trans }}" hidden>
                    <svg viewBox="0 0 24 24"><path d="M19 7h-8v6h8V7zm4 12V4.98C23 3.88 22.1 3 21 3H3c-1.1 0-2 .88-2 1.98V19c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2zm-2 .02H3V4.97h18v14.05z"/></svg>
                </button>
                <button id="player-rg" class="rg-btn" type="button" aria-label="{{ 'player.replaygain'|trans }}">RG</button>
                <input type="range" id="player-volume" min="0" max="100" value="100" title="{{ 'player.volume'|trans }}">
            </div>
            <audio id="audio" preload="metadata"></audio>
        </footer>

        {# The play queue (what plays now and next), filled by player.js #}
        <aside id="queue-panel" class="lyrics-panel queue-panel" aria-label="{{ 'player.queue'|trans }}" hidden>
            <div class="lyrics-panel-head">
                <h2>{{ 'player.queue'|trans }} <span id="queue-count" class="muted"></span></h2>
                <div class="queue-head-actions">
                    <button id="queue-clear" type="button" class="queue-clear" title="{{ 'queue.clear_title'|trans }}">{{ 'queue.clear'|trans }}</button>
                    <button id="queue-close" type="button" title="{{ 'common.close_esc'|trans }}" aria-label="{{ 'queue.close'|trans }}">✕</button>
                </div>
            </div>
            <ol id="queue-body" class="lyrics-panel-body queue-list"></ol>
        </aside>

        {# Lyrics of the playing track (synced LRC scrolls with the song), filled by player.js #}
        <aside id="lyrics-panel" class="lyrics-panel" aria-label="{{ 'player.lyrics'|trans }}" hidden>
            <div class="lyrics-panel-head">
                <h2>{{ 'player.lyrics'|trans }}</h2>
                <button id="lyrics-close" type="button" title="{{ 'common.close_esc'|trans }}" aria-label="{{ 'lyrics.close'|trans }}">✕</button>
            </div>
            <div id="lyrics-body" class="lyrics-panel-body"></div>
        </aside>

        {# YouTube lightbox, opened by public/video-lightbox.js #}
        <dialog id="video-lightbox" class="video-lightbox" aria-label="{{ 'video.lightbox_label'|trans }}">
            <div class="video-lightbox-head">
                <span class="video-lightbox-title"></span>
                <button type="button" class="video-lightbox-close" title="{{ 'common.close_esc'|trans }}" aria-label="{{ 'video.close'|trans }}">✕</button>
            </div>
            <div class="video-lightbox-frame">
                <iframe src="about:blank" title="{{ 'video.iframe_title'|trans }}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
        </dialog>

        {# Shared per-track context menu, populated + positioned by player.js #}
        <div id="track-menu" class="context-menu" role="menu"></div>

        <script type="application/json" id="i18n-config">{{ {locale: app.request.locale, messages: js_translations()}|json_encode|raw }}</script>

        {% block player_config %}
            <script type="application/json" id="player-config">
                {
                    "recordUrl": "{{ path('app_play_record', {id: 0}) }}"
                    , "playbackUrl": "{{ path('app_song_playback', {id: 0}) }}"
                    {% if app.user %}
                    , "favoriteCsrf": "{{ csrf_token('favorite') }}"
                    , "ratingCsrf": "{{ csrf_token('rating') }}"
                    , "ratingUrl": "{{ path('app_rating_set', {id: 0}) }}"
                    {% if is_granted('ROLE_ADMIN') %}
                    , "banUrl": "{{ path('app_song_ban', {id: 0}) }}"
                    , "banCsrf": "{{ csrf_token('ban') }}"
                    {% endif %}
                    , "listenLaterToggleUrl": "{{ path('app_listen_later_toggle', {id: 0}) }}"
                    , "listenLaterCsrf": "{{ csrf_token('listen_later') }}"
                    , "offlineToggleUrl": "{{ path('app_offline_toggle', {id: 0}) }}"
                    , "offlineCsrf": "{{ csrf_token('offline') }}"
                    {% endif %}
                }
            </script>
        {% endblock %}

        <script>
            // "/" focuses the global search from anywhere (except while typing).
            document.addEventListener('keydown', (e) => {
                if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
                const t = e.target;
                if (t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
                const field = document.getElementById('global-search');
                if (field) { e.preventDefault(); field.focus(); field.select(); }
            });

            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js').catch(() => {
                        // Service worker registration failures should never break the app.
                    });
                });
            }
        </script>

        {# Plain static scripts served from public/ — player first (registers
           window.appPageInit), then nav (partial navigation). #}
        <script src="/i18n.js" defer></script>
        <script src="/player.js" defer></script>
        <script src="/nav.js" defer></script>
        <script src="/video-lightbox.js" defer></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
