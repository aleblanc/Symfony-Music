{% extends 'base.html.twig' %}
{% import 'partials/_video_card.html.twig' as video %}

{% block title %}{{ 'videos.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ 'videos.heading'|trans }}</h1>
    <p class="section-sub">
        {% if onlyNew %}
            {{ 'videos.new_since_visit'|trans({count: total}) }} ·
            <a class="link" href="{{ path('app_videos') }}">{{ 'videos.show_all'|trans }}</a>
        {% else %}
            {{ 'videos.latest'|trans }}{% if total > limit %} {{ 'videos.latest_limit'|trans({limit: limit}) }}{% endif %}
            {% if newCount %}· <a href="{{ path('app_videos', {new: 1}) }}"><span class="badge-new">{{ 'videos.new_badge'|trans({count: newCount}) }}</span></a>{% endif %}
        {% endif %}
    </p>

    {% if items is empty %}
        <p class="muted">{{ (onlyNew ? 'videos.empty_new' : 'videos.empty')|trans }}</p>
    {% else %}
        <div class="video-grid">
            {% for v in items %}
                {{ video.card(v, v.new, v.artist) }}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
