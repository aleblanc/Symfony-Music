{% extends 'base.html.twig' %}
{% import 'partials/_post_card.html.twig' as post %}

{% block title %}New posts · PHP Music{% endblock %}

{% block body %}
    <h1>New Instagram posts</h1>
    <p class="section-sub">
        {% if onlyNew %}
            {{ total }} new post{{ total == 1 ? '' : 's' }} since your last visit of each artist page ·
            <a class="link" href="{{ path('app_posts') }}">show all latest posts</a>
        {% else %}
            Latest Instagram posts of your artists, newest first{% if total > limit %} (the {{ limit }} most recent){% endif %}
            {% if newCount %}· <a href="{{ path('app_posts', {new: 1}) }}"><span class="badge-new">{{ newCount }} new</span></a>{% endif %}
        {% endif %}
    </p>

    {% if items is empty %}
        <p class="muted">No post{{ onlyNew ? ' new since your last visits' : ' yet: run php bin/console app:artist:posts' }}.</p>
    {% else %}
        <div class="video-grid post-grid">
            {% for v in items %}
                {{ post.card(v, v.new, v.artist) }}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
