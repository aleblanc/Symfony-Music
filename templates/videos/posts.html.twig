{% extends 'base.html.twig' %}
{% import 'partials/_post_card.html.twig' as post %}

{% block title %}{{ 'posts.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ 'posts.heading'|trans }}</h1>
    <p class="section-sub">
        {% if onlyNew %}
            {{ 'posts.new_since_visit'|trans({count: total}) }} ·
            <a class="link" href="{{ path('app_posts') }}">{{ 'posts.show_all'|trans }}</a>
        {% else %}
            {{ 'posts.latest'|trans }}{% if total > limit %} {{ 'videos.latest_limit'|trans({limit: limit}) }}{% endif %}
            {% if newCount %}· <a href="{{ path('app_posts', {new: 1}) }}"><span class="badge-new">{{ 'posts.new_badge'|trans({count: newCount}) }}</span></a>{% endif %}
        {% endif %}
    </p>

    {% if items is empty %}
        <p class="muted">{{ (onlyNew ? 'posts.empty_new' : 'posts.empty')|trans }}</p>
    {% else %}
        <div class="video-grid post-grid">
            {% for v in items %}
                {{ post.card(v, v.new, v.artist) }}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
