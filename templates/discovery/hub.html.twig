{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}
{% import 'discovery/_shelf.html.twig' as shelfMacros %}

{% block title %}Discover · PHP Music{% endblock %}

{% block body %}
    <h1>Discover</h1>

    {% if not app.user %}
        <p class="muted"><a href="{{ path('app_login') }}">Log in</a> to get recommendations based on your
            own listening history.</p>
    {% endif %}

    {% if trending is not empty %}
        <section class="shelf">
            <h2>Trending <a class="btn-link" href="{{ path('app_discover_trending') }}">See all →</a></h2>
            {{ tracks.track_list(trending, favoriteIds, listenLaterIds, offlineIds) }}
        </section>
    {% endif %}

    {% if app.user %}
        <p><a class="btn" href="{{ path('app_discover_recommendations') }}">See your personal recommendations →</a></p>
    {% endif %}

    {% for shelf in shelves %}
        {{ shelfMacros.shelf(shelf, favoriteIds, listenLaterIds, offlineIds) }}
    {% endfor %}

    {% if mixes is not empty %}
        <section class="shelf">
            <h2>Mixes <a class="btn-link" href="{{ path('app_discover_mixes') }}">See all →</a></h2>
            <div class="card-grid">
                {% for mix in mixes %}
                    <a class="card" href="{{ path('app_mix_show', {publicId: mix.publicId}) }}">
                        {% if mix.imageId %}
                            <img src="{{ path('app_cover', {id: mix.imageId}) }}" alt="" loading="lazy"
                                 style="aspect-ratio:1;border-radius:8px;object-fit:cover;">
                        {% endif %}
                        <div class="card-title">{{ mix.name }}</div>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if trending is empty and shelves is empty and mixes is empty %}
        <p class="muted">Nothing to discover yet — scan some music into the library first.</p>
    {% endif %}
{% endblock %}
