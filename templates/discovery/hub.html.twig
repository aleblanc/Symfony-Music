{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}
{% import 'discovery/_shelf.html.twig' as shelfMacros %}

{% block title %}{{ 'discovery.hub.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ 'discovery.hub.title'|trans }}</h1>

    {% if not app.user %}
        <p class="muted">{{ 'discovery.hub.login_hint_html'|trans({login_url: path('app_login')|e})|raw }}</p>
    {% endif %}

    {% if trending is not empty %}
        <section class="shelf">
            <h2>{{ 'discovery.hub.trending'|trans }} <a class="btn-link" href="{{ path('app_discover_trending') }}">{{ 'common.see_all_arrow'|trans }}</a></h2>
            {{ tracks.track_list(trending, favoriteIds, listenLaterIds, offlineIds) }}
        </section>
    {% endif %}

    {% if app.user %}
        <p><a class="btn" href="{{ path('app_discover_recommendations') }}">{{ 'discovery.hub.personal_reco'|trans }} →</a></p>
    {% endif %}

    {% for shelf in shelves %}
        {{ shelfMacros.shelf(shelf, favoriteIds, listenLaterIds, offlineIds) }}
    {% endfor %}

    {% if mixes is not empty %}
        <section class="shelf">
            <h2>{{ 'discovery.hub.mixes'|trans }} <a class="btn-link" href="{{ path('app_discover_mixes') }}">{{ 'common.see_all_arrow'|trans }}</a></h2>
            <div class="card-grid">
                {% for mix in mixes %}
                    <a class="card" href="{{ path('app_mix_show', {publicId: mix.publicId}) }}">
                        {% if mix.imageId %}
                            <img src="{{ path('app_cover', {id: mix.imageId}) }}" alt="" loading="lazy"
                                 style="aspect-ratio:1;border-radius:8px;object-fit:cover;">
                        {% endif %}
                        <div class="card-title">{{ mix.name }}</div>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if trending is empty and shelves is empty and mixes is empty %}
        <p class="muted">{{ 'discovery.hub.empty'|trans }}</p>
    {% endif %}
{% endblock %}
