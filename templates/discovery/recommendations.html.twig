{% extends 'base.html.twig' %}
{% import 'discovery/_shelf.html.twig' as shelfMacros %}

{% block title %}{{ 'discovery.recommendations.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ 'discovery.recommendations.title'|trans }}</h1>
    <p class="section-sub">{{ 'discovery.recommendations.subtitle'|trans }}</p>

    {% if shelves is empty %}
        <p class="muted">{{ 'discovery.recommendations.empty_html'|trans({discover_url: path('app_discover')|e})|raw }}</p>
    {% else %}
        {% for shelf in shelves %}
            {{ shelfMacros.shelf(shelf, favoriteIds, listenLaterIds, offlineIds) }}
        {% endfor %}
    {% endif %}
{% endblock %}
