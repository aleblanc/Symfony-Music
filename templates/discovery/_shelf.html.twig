{#
 # Renders one "shelf" (a titled row of items) from RecommendationService.
 # A shelf is {title, type, items} where type is 'songs', 'albums' or
 # 'artists' — each rendered differently since they carry different data
 # shapes (Music entities vs plain album/artist arrays).
 #}
{% macro shelf(shelf, favoriteIds, listenLaterIds = [], offlineIds = []) %}
    {% import 'partials/_tracks.html.twig' as tracks %}
    <section class="shelf">
        <h2>{{ shelf.title }}</h2>
        {% if shelf.type == 'songs' %}
            {{ tracks.track_list(shelf.items, favoriteIds, listenLaterIds, offlineIds) }}
        {% elseif shelf.type == 'albums' %}
            <div class="card-grid">
                {% for a in shelf.items %}
                    <a class="card" href="{{ path('app_album', {name: a.album}) }}">
                        <img src="{{ path('app_cover', {id: a.id}) }}" alt="" loading="lazy"
                             style="aspect-ratio:1;border-radius:8px;object-fit:cover;">
                        <div class="card-title">{{ a.album }}</div>
                        <div class="card-sub">{{ a.artist }} · {{ a.songCount }} track{{ a.songCount == 1 ? '' : 's' }}</div>
                    </a>
                {% endfor %}
            </div>
        {% elseif shelf.type == 'artists' %}
            <div class="card-grid">
                {% for a in shelf.items %}
                    <a class="card" href="{{ path('app_artist', {name: a.name}) }}">
                        <div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:44px;font-weight:800;background:var(--bg-elev-2);border-radius:8px;">
                            {{ a.name|slice(0, 1)|upper }}
                        </div>
                        <div class="card-title">{{ a.name }}</div>
                        {% if a.isUser %}<div class="card-sub">Registered artist</div>{% endif %}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endmacro %}
