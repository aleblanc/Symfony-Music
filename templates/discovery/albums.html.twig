{% extends 'base.html.twig' %}
{% import 'partials/_disco.html.twig' as disco %}

{% block title %}{{ 'discovery.albums.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ 'discovery.albums.heading'|trans }}</h1>
    <p class="section-sub">
        {{ 'discovery.albums.intro'|trans({count: cards|length}) }}
        <a class="link" href="{{ path('app_discover') }}">← {{ 'nav.discover'|trans }}</a>
    </p>
    {% if cards is empty %}
        <p class="muted">{{ 'discovery.albums.empty_html'|trans|raw }}</p>
    {% else %}
        <div class="card-grid disco-discover">
            {% for d in cards %}
                {{ disco.card(d, 'all-' ~ loop.index, true) }}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
