{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}

{% block title %}{{ 'discovery.trending.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ 'discovery.trending.title'|trans }}</h1>
    <p class="section-sub">{{ 'discovery.trending.subtitle'|trans }}</p>

    {{ tracks.track_list(songs, favoriteIds, listenLaterIds, offlineIds) }}

    <div class="pagination">
        {% if page > 1 %}<a href="{{ path('app_discover_trending', {page: page - 1}) }}">{{ 'common.pagination.prev'|trans }}</a>{% endif %}
        <span class="current">{{ 'discovery.trending.page'|trans({page: page}) }}</span>
        {% if songs|length > 0 %}<a href="{{ path('app_discover_trending', {page: page + 1}) }}">{{ 'common.pagination.next'|trans }}</a>{% endif %}
    </div>
{% endblock %}
