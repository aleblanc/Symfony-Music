{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}

{% block title %}Library · PHP Music{% endblock %}

{% block body %}
    <h1>{{ query ? 'Results for “' ~ query ~ '”' : 'Library' }}</h1>
    <p class="section-sub">
        {{ total }} {{ query ? 'result' : 'track' }}{{ total == 1 ? '' : 's' }}
        {% if query %} · <a class="link" href="{{ path('app_library') }}">Clear search</a>{% endif %}
    </p>

    {% if is_granted('ROLE_ADMIN') %}
        <form class="admin-actions" method="post" action="{{ path('app_admin_rescan') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_rescan') }}">
            <button class="btn btn-ghost" type="submit" name="force" value="0">Rescan library</button>
            <button class="btn btn-ghost" type="submit" name="force" value="1">Force full rescan</button>
            <a class="btn btn-ghost" href="{{ path('app_suggestions') }}">Metadata suggestions</a>
        </form>
    {% endif %}

    <nav class="sort-bar" aria-label="Sort">
        <span class="muted">Sort by</span>
        <a href="{{ path('app_library', {q: query, sort: sort == 'artist_asc' ? 'artist_desc' : 'artist_asc'}) }}"
           class="{{ sort starts with 'artist' ? 'active' }}">Artist {{ sort == 'artist_desc' ? '↓' : '↑' }}</a>
        <a href="{{ path('app_library', {q: query, sort: sort == 'album_asc' ? 'album_desc' : 'album_asc'}) }}"
           class="{{ sort starts with 'album' ? 'active' }}">Album {{ sort == 'album_desc' ? '↓' : '↑' }}</a>
        <a href="{{ path('app_library', {q: query, sort: sort == 'year_desc' ? 'year_asc' : 'year_desc'}) }}"
           class="{{ sort starts with 'year' ? 'active' }}">Year {{ sort == 'year_asc' ? '↑' : '↓' }}</a>
    </nav>

    {{ tracks.track_list(songs, favoriteIds, listenLaterIds, offlineIds) }}

    {% if pages > 1 %}
        <div class="pagination">
            {% if page > 1 %}<a href="{{ path('app_library', {q: query, sort: sort, page: page - 1}) }}">← Prev</a>{% endif %}
            <span class="current">{{ page }} / {{ pages }}</span>
            {% if page < pages %}<a href="{{ path('app_library', {q: query, sort: sort, page: page + 1}) }}">Next →</a>{% endif %}
        </div>
    {% endif %}
{% endblock %}
