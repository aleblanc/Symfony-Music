{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}
{% import 'partials/_play_all.html.twig' as playAll %}

{% set label = name == 'discover' ? 'Discover folder' : 'Unclassified folder' %}
{% block title %}{{ label }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ label }}</h1>
    <p class="section-sub">
        {{ count }} track{{ count == 1 ? '' : 's' }} in <code>MUSIC_DIR/{{ folder }}</code>
        {% if name == 'discover' %}— albums fetched by <code>app:discovery-dl</code> from your Favorite discography.
        {% else %}— files <code>app:import</code> could not identify, kept as they are.{% endif %}
    </p>
    {% if count == 0 %}
        <p class="muted">Empty for now{% if name == 'discover' %}: run <code>php bin/console app:discovery-dl</code>{% endif %}, then <code>app:scan</code>.</p>
    {% else %}
        {# The playlist form takes the folder's name; the folder itself is under MUSIC_DIR. #}
        {{ playAll.bar('folder', name, '#page-tracks', label) }}
        <div id="page-tracks">
            {% for dir, songs in groups %}
                <section class="folder-group">
                    <h2 class="folder-path">{{ dir == '.' ? '(folder root)' : dir }} <span class="muted">· {{ songs|length }}</span></h2>
                    {{ tracks.track_list(songs, favoriteIds, listenLaterIds, offlineIds) }}
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
