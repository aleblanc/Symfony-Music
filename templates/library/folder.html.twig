{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}
{% import 'partials/_play_all.html.twig' as playAll %}
{% import 'partials/_disco.html.twig' as disco %}

{% set label = name == 'discover' ? 'Discover folder' : 'Unclassified folder' %}
{% block title %}{{ label }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ label }}</h1>
    <p class="section-sub">
        {{ count }} track{{ count == 1 ? '' : 's' }} in <code>MUSIC_DIR/{{ folder }}</code>
        {% if name == 'discover' %}— albums to discover, e.g. from your Favorite discography.
        {% else %}— files <code>app:import</code> could not identify, kept as they are.{% endif %}
    </p>
    {% if count == 0 %}
        <p class="muted">Empty for now: files put in this folder show up here after <code>php bin/console app:scan</code>.</p>
    {% else %}
        {# The playlist form takes the folder's name; the folder itself is under MUSIC_DIR. #}
        {{ playAll.bar('folder', name, '#page-tracks', label) }}
        <div id="page-tracks">
            {% for dir, songs in groups %}
                <section class="folder-group">
                    <div class="folder-head">
                        <h2 class="folder-path">{{ dir == '.' ? '(folder root)' : dir }} <span class="muted">· {{ songs|length }}</span>
                            {%- if tracklists[dir] is defined %}{{ disco.tracklist(tracklists[dir], 'folder-' ~ loop.index, true) }}{% endif %}</h2>
                        <button class="btn btn-sm" type="button" data-play-all="#folder-group-{{ loop.index }}">▶ Play all</button>
                        <button class="btn btn-sm btn-ghost" type="button" data-queue-all="#folder-group-{{ loop.index }}" title="Add this folder's tracks to the play queue">+ Queue</button>
                    </div>
                    <div id="folder-group-{{ loop.index }}">
                        {{ tracks.track_list(songs, favoriteIds, listenLaterIds, offlineIds) }}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
