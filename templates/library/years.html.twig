{% extends 'base.html.twig' %}

{% block title %}Years · PHP Music{% endblock %}

{% block body %}
    <h1>Years</h1>
    <p class="section-sub">{{ years|length }} year{{ years|length == 1 ? '' : 's' }}</p>

    {% if years is empty %}
        <p class="muted">No years yet — run a scan first.</p>
    {% else %}
        <div class="card-grid">
            {% for y in years %}
                <a class="card" href="{{ path('app_year', {year: y.year}) }}">
                    <div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:800;background:var(--bg-elev-2);border-radius:8px;">
                        {{ y.year }}
                    </div>
                    <div class="card-title">{{ y.year }}</div>
                    <div class="card-sub">{{ y.cnt }} track{{ y.cnt == 1 ? '' : 's' }}</div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
