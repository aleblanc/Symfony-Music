{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}

{% block title %}{{ album }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ album }}</h1>
    <p class="section-sub">{{ songs|length }} track{{ songs|length == 1 ? '' : 's' }}</p>
    {{ tracks.track_list(songs, favoriteIds, listenLaterIds, offlineIds) }}
{% endblock %}
