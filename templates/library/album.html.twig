{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}
{% import 'partials/_play_all.html.twig' as playAll %}

{% block title %}{{ album }} · PHP Music{% endblock %}

{% block body %}
    {% import 'partials/_disco.html.twig' as disco %}
    <h1>{{ album }}{% if tracklist %}{{ disco.tracklist(tracklist, 'album', true) }}{% endif %}</h1>
    <p class="section-sub">{{ songs|length }} track{{ songs|length == 1 ? '' : 's' }}</p>
    {{ playAll.bar('album', album) }}
    <div id="page-tracks">
        {{ tracks.track_list(songs, favoriteIds, listenLaterIds, offlineIds) }}
    </div>
{% endblock %}
