{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}
{% import 'partials/_icons.html.twig' as icons %}

{% block title %}Home · PHP Music{% endblock %}

{% block body %}
    <header class="home-hero">
        <div>
            <span class="eyebrow">{{ 'now'|date('l j F') }}</span>
            <h1>Welcome{{ app.user ? ', ' ~ app.user.artist }}</h1>
            <p class="muted">{{ total|number_format(0, '.', ' ') }} tracks in the library.</p>
            {% if not app.user %}
                <p class="muted">Browse and play everything as a guest, or
                    <a class="link" href="{{ path('app_login') }}">log in</a> to keep favorites, playlists and history.</p>
            {% endif %}
        </div>
        <div class="home-shortcuts">
            <a class="shortcut" href="{{ path('app_library') }}">{{ icons.icon('library') }}<span>Library</span></a>
            <a class="shortcut" href="{{ path('app_discover') }}">{{ icons.icon('discover') }}<span>Discover</span></a>
            {% if app.user %}
                <a class="shortcut" href="{{ path('app_favorites') }}">{{ icons.icon('heart') }}<span>Favorites</span></a>
                <a class="shortcut" href="{{ path('app_playlists') }}">{{ icons.icon('playlist') }}<span>Playlists</span></a>
            {% endif %}
        </div>
    </header>

    {% if recentlyAdded is not empty %}
        <section class="shelf">
            <div class="shelf-head">
                <h2>{{ icons.icon('sparkle') }} Recently added</h2>
                <a class="link" href="{{ path('app_library') }}">Browse library →</a>
            </div>
            <div class="card-grid card-grid--scroll">
                {% for song in recentlyAdded %}
                    <div class="card song-card" data-track
                         data-track-id="{{ song.id }}"
                         data-track-title="{{ song.displayTitle }}"
                         data-track-artist="{{ song.artist }}"
                         data-track-album="{{ song.album }}"
                         data-track-url="{{ path('app_song', {id: song.id}) }}"
                         data-track-artist-url="{{ song.artist ? path('app_artist', {name: song.artist}) }}"
                         data-track-album-url="{{ song.album ? path('app_album', {name: song.album}) }}"
                         data-track-stream="{{ path('app_stream', {id: song.id}) }}"
                         data-track-cover="{{ path('app_cover', {id: song.id}) }}">
                        <div class="card-art">
                            <a href="{{ path('app_song', {id: song.id}) }}" tabindex="-1">
                                <img src="{{ path('app_cover', {id: song.id}) }}" alt="" loading="lazy">
                            </a>
                            <button class="card-play" data-play title="Play" aria-label="Play {{ song.displayTitle }}">{{ icons.icon('play') }}</button>
                            {% if loop.index <= 3 %}<span class="card-flag">New</span>{% endif %}
                        </div>
                        <a class="card-title" href="{{ path('app_song', {id: song.id}) }}">{{ song.displayTitle }}</a>
                        <div class="card-sub">
                            {% if song.artist %}<a href="{{ path('app_artist', {name: song.artist}) }}">{{ song.artist }}</a>{% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if recent is not empty %}
        <section class="shelf">
            <div class="shelf-head"><h2>{{ icons.icon('clock') }} Recently played</h2></div>
            {{ tracks.track_list(recent, favoriteIds, listenLaterIds, offlineIds) }}
        </section>
    {% endif %}

    {% if topSongs is not empty %}
        <section class="shelf">
            <div class="shelf-head"><h2>{{ icons.icon('heart') }} Your top tracks</h2></div>
            {{ tracks.track_list(topSongs, favoriteIds, listenLaterIds, offlineIds) }}
        </section>
    {% endif %}

    {% if total == 0 %}
        <section class="panel">
            <h2>Get started</h2>
            <p class="muted">Point <code>MUSIC_DIR</code> at your library and run
                <code>php bin/console app:scan</code>, then browse the
                <a class="link" href="{{ path('app_library') }}">Library</a>.</p>
        </section>
    {% endif %}
{% endblock %}
