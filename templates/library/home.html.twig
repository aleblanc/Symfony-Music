{% extends 'base.html.twig' %}
{% import 'partials/_tracks.html.twig' as tracks %}
{% import 'partials/_icons.html.twig' as icons %}

{% block title %}{{ 'library.home.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <header class="home-hero">
        <div>
            <span class="eyebrow">{{ 'now'|format_date(pattern: 'EEEE d MMMM') }}</span>
            <h1>{{ app.user ? 'library.home.welcome_user'|trans({name: app.user.artist}) : 'library.home.welcome'|trans }}</h1>
            <p class="muted">{{ 'library.home.total_tracks'|trans({count: total}) }}</p>
            {% if not app.user %}
                <p class="muted">{{ 'library.home.guest_hint_html'|trans({login_url: path('app_login')|e})|raw }}</p>
            {% endif %}
        </div>
        <div class="home-shortcuts">
            <a class="shortcut" href="{{ path('app_library') }}">{{ icons.icon('library') }}<span>{{ 'nav.library'|trans }}</span></a>
            <a class="shortcut" href="{{ path('app_discover') }}">{{ icons.icon('discover') }}<span>{{ 'nav.discover'|trans }}</span></a>
            {% if app.user %}
                <a class="shortcut" href="{{ path('app_favorites') }}">{{ icons.icon('heart') }}<span>{{ 'nav.favorites'|trans }}</span></a>
                <a class="shortcut" href="{{ path('app_playlists') }}">{{ icons.icon('playlist') }}<span>{{ 'nav.playlists'|trans }}</span></a>
            {% endif %}
        </div>
    </header>

    {% if recentlyAdded is not empty %}
        <section class="shelf">
            <div class="shelf-head">
                <h2>{{ icons.icon('sparkle') }} {{ 'library.home.recently_added'|trans }}</h2>
                <a class="link" href="{{ path('app_library') }}">{{ 'library.home.browse_library'|trans }} →</a>
            </div>
            <div class="card-grid card-grid--scroll">
                {% for song in recentlyAdded %}
                    <div class="card song-card" data-track
                         data-track-id="{{ song.id }}"
                         data-track-title="{{ song.displayTitle }}"
                         data-track-artist="{{ song.artist }}"
                         data-track-album="{{ song.album }}"
                         data-track-url="{{ path('app_song', {id: song.id}) }}"
                         data-track-artist-url="{{ song.artist ? path('app_artist', {name: song.artist}) }}"
                         data-track-album-url="{{ song.album ? path('app_album', {name: song.album}) }}"
                         data-track-stream="{{ path('app_stream', {id: song.id}) }}"
                         data-track-cover="{{ path('app_cover', {id: song.id}) }}">
                        <div class="card-art">
                            <a href="{{ path('app_song', {id: song.id}) }}" tabindex="-1">
                                <img src="{{ path('app_cover', {id: song.id}) }}" alt="" loading="lazy">
                            </a>
                            <button class="card-play" data-play title="{{ 'common.play'|trans }}" aria-label="{{ 'library.home.play_aria'|trans({title: song.displayTitle}) }}">{{ icons.icon('play') }}</button>
                            {% if loop.index <= 3 %}<span class="card-flag">{{ 'library.home.new_flag'|trans }}</span>{% endif %}
                        </div>
                        <a class="card-title" href="{{ path('app_song', {id: song.id}) }}">{{ song.displayTitle }}</a>
                        <div class="card-sub">
                            {% if song.artist %}<a href="{{ path('app_artist', {name: song.artist}) }}">{{ song.artist }}</a>{% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if recent is not empty %}
        <section class="shelf">
            <div class="shelf-head"><h2>{{ icons.icon('clock') }} {{ 'library.home.recently_played'|trans }}</h2></div>
            {{ tracks.track_list(recent, favoriteIds, listenLaterIds, offlineIds) }}
        </section>
    {% endif %}

    {% if topSongs is not empty %}
        <section class="shelf">
            <div class="shelf-head"><h2>{{ icons.icon('heart') }} {{ 'library.home.top_tracks'|trans }}</h2></div>
            {{ tracks.track_list(topSongs, favoriteIds, listenLaterIds, offlineIds) }}
        </section>
    {% endif %}

    {% if total == 0 %}
        <section class="panel">
            <h2>{{ 'library.home.get_started'|trans }}</h2>
            <p class="muted">{{ 'library.home.get_started_text_html'|trans({library_url: path('app_library')|e})|raw }}</p>
        </section>
    {% endif %}
{% endblock %}
