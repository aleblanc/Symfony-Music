{% extends 'base.html.twig' %}

{% block title %}Artists · PHP Music{% endblock %}

{% block body %}
    <h1>Artists</h1>
    <p class="section-sub">{{ artists|length }} artist{{ artists|length == 1 ? '' : 's' }}</p>

    {% if artists is empty %}
        <p class="muted">No artists yet — run a scan first.</p>
    {% else %}
        <div class="card-grid">
            {% for a in artists %}
                <a class="card" href="{{ path('app_artist', {name: a.artist}) }}">
                    <div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:44px;font-weight:800;background:var(--bg-elev-2);border-radius:8px;">
                        {{ a.artist|slice(0, 1)|upper }}
                    </div>
                    <div class="card-title">{{ a.artist }}</div>
                    <div class="card-sub">{{ a.cnt }} track{{ a.cnt == 1 ? '' : 's' }}</div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
