{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.register.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <div class="auth-wrap">
        <h1>{{ 'auth.register.title'|trans }}</h1>

        {% if error %}
            <div class="flash flash-error">{{ error|trans }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_register') }}">
            <div class="field">
                <label for="email">{{ 'auth.email'|trans }}</label>
                <input type="email" id="email" name="email" value="{{ email }}" autocomplete="email" required autofocus>
            </div>
            <div class="field">
                <label for="artist">{{ 'auth.register.artist'|trans }}</label>
                <input type="text" id="artist" name="artist" value="{{ artist }}" required>
            </div>
            <div class="field">
                <label for="password">{{ 'auth.password'|trans }}</label>
                <input type="password" id="password" name="password" autocomplete="new-password" minlength="6" required>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
            <button class="btn" type="submit" style="width:100%;">{{ 'auth.register.submit'|trans }}</button>
        </form>

        <p class="auth-alt">{{ 'auth.register.already'|trans }} <a href="{{ path('app_login') }}">{{ 'auth.register.log_in_link'|trans }}</a></p>
    </div>
{% endblock %}
