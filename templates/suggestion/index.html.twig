{% extends 'base.html.twig' %}

{% block title %}{{ 'suggestion.index.heading'|trans }} · PHP Music{% endblock %}

{% macro value(v) %}{{ v is same as(null) or v == '' ? '—' : v }}{% endmacro %}

{% block body %}
    {% import _self as m %}
    <h1>{{ 'suggestion.index.heading'|trans }}</h1>
    <p class="section-sub">
        {{ 'suggestion.index.intro_html'|trans|raw }}
    </p>

    <nav class="sort-bar" aria-label="{{ 'suggestion.index.status_nav_aria'|trans }}">
        {% for s in statuses %}
            <a href="{{ path('app_suggestions', {status: s.value}) }}" class="{{ s == status ? 'active' }}">
                {{ ('suggestion.status.' ~ s.value)|trans }} <span class="muted">{{ counts[s.value] ?? 0 }}</span>
            </a>
        {% endfor %}
    </nav>

    {% if groups is empty %}
        <p class="muted">{{ 'suggestion.index.empty'|trans }}</p>
    {% endif %}

    {% for key, items in groups %}
        {% set first = items|first %}
        <section class="suggestion-group">
            <header class="suggestion-group-head">
                {% if first.hasCover %}
                    <img src="{{ path('app_suggestion_cover', {id: first.id}) }}" alt="" width="64" height="64">
                {% endif %}
                <div>
                    <strong>{{ m.value(first.proposedValue('album')) }}</strong>
                    <div class="muted">
                        {{ m.value(first.proposedValue('albumArtist') ?? first.proposedValue('artist')) }}
                        {% if first.proposedValue('year') %} · {{ first.proposedValue('year') }}{% endif %}
                        {% if first.releaseId %} · <a class="link" href="https://musicbrainz.org/release/{{ first.releaseId }}" target="_blank" rel="noopener">MusicBrainz ↗</a>{% endif %}
                    </div>
                </div>
                {% if status.value == 'pending' and first.releaseId and items|length > 1 %}
                    <form method="post" action="{{ path('app_suggestion_accept_release', {releaseId: first.releaseId, status: status.value}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('suggestion_release_' ~ first.releaseId) }}">
                        <button class="btn btn-sm" type="submit">{{ 'suggestion.index.accept_album'|trans({count: items|length}) }}</button>
                    </form>
                {% endif %}
            </header>

            <table class="suggestion-table">
                <thead>
                    <tr><th>{{ 'suggestion.index.col_file'|trans }}</th><th>{{ 'suggestion.index.col_current'|trans }}</th><th>{{ 'suggestion.index.col_proposed'|trans }}</th><th>{{ 'suggestion.index.col_score'|trans }}</th><th></th></tr>
                </thead>
                <tbody>
                {% for s in items %}
                    {% set song = s.music %}
                    {% set before = s.previous ?? {
                        title: song.title, artist: song.artist, album: song.album,
                        trackNumber: song.trackNumber, year: song.year,
                    } %}
                    <tr>
                        <td class="file" title="{{ song.file }}">{{ song.file|split('/')|last }}</td>
                        <td>
                            {% if before.trackNumber %}{{ '%02d'|format(before.trackNumber) }}. {% endif %}{{ m.value(before.title) }}
                            <div class="muted">{{ m.value(before.artist) }} · {{ m.value(before.album) }}{% if before.year %} ({{ before.year }}){% endif %}</div>
                        </td>
                        <td>
                            {% if s.proposedValue('trackNumber') %}{{ '%02d'|format(s.proposedValue('trackNumber')) }}. {% endif %}{{ m.value(s.proposedValue('title')) }}
                            <div class="muted">
                                {{ m.value(s.proposedValue('artist')) }} · {{ m.value(s.proposedValue('album')) }}
                                {% if s.proposedValue('year') %} ({{ s.proposedValue('year') }}){% endif %}
                                {% if s.proposedValue('genre') %} · {{ s.proposedValue('genre') }}{% endif %}
                                {% if s.hasCover %} · {{ 'suggestion.index.plus_cover'|trans }}{% endif %}
                            </div>
                            {% if s.error %}<div class="flash-error suggestion-error">{{ s.error }}</div>{% endif %}
                        </td>
                        <td>
                            <span class="score {{ s.score >= 0.85 ? 'score-high' : (s.score >= 0.65 ? 'score-mid' : 'score-low') }}">{{ (s.score * 100)|round }}%</span>
                            <div class="muted">{{ s.source }}</div>
                        </td>
                        <td class="actions">
                            {% if s.pending %}
                                <form method="post" action="{{ path('app_suggestion_accept', {id: s.id, status: status.value}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('suggestion_' ~ s.id) }}">
                                    <button class="btn btn-sm" type="submit">{{ 'suggestion.index.accept'|trans }}</button>
                                </form>
                                <form method="post" action="{{ path('app_suggestion_reject', {id: s.id, status: status.value}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('suggestion_' ~ s.id) }}">
                                    <button class="btn btn-sm btn-ghost" type="submit">{{ 'suggestion.index.reject'|trans }}</button>
                                </form>
                            {% elseif s.status.value == 'applied' %}
                                <form method="post" action="{{ path('app_suggestion_revert', {id: s.id, status: status.value}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('suggestion_' ~ s.id) }}">
                                    <button class="btn btn-sm btn-danger" type="submit">{{ 'suggestion.index.revert'|trans }}</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
    {% endfor %}
{% endblock %}
