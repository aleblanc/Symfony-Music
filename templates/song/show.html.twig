{% extends 'base.html.twig' %}

{% block title %}{{ song.displayTitle }} · PHP Music{% endblock %}

{% macro icon(path) %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="{{ path }}"/></svg>{% endmacro %}

{% block body %}
    {% import _self as ui %}
    {% set quality = song.quality %}
    {% set kbps = song.bitrate ? (song.bitrate / 1000)|round : null %}

    <div class="song-detail" data-track
         data-track-id="{{ song.id }}"
         data-track-title="{{ song.displayTitle }}"
         data-track-artist="{{ song.artist }}"
         data-track-album="{{ song.album }}"
         data-track-url="{{ path('app_song', {id: song.id}) }}"
         data-track-artist-url="{{ song.artist ? path('app_artist', {name: song.artist}) }}"
         data-track-album-url="{{ song.album ? path('app_album', {name: song.album}) }}"
         data-track-stream="{{ path('app_stream', {id: song.id}) }}"
         data-track-cover="{{ path('app_cover', {id: song.id}) }}"
         {% if app.user %}
         data-settings-get-url="{{ path('app_song_settings_get', {id: song.id}) }}"
         data-settings-save-url="{{ path('app_song_settings_save', {id: song.id}) }}"
         data-settings-reset-url="{{ path('app_song_settings_reset', {id: song.id}) }}"
         data-settings-csrf="{{ csrf_token('song_settings_' ~ song.id) }}"
         {% endif %}>

        <header class="song-hero">
            <img class="song-cover" src="{{ path('app_cover', {id: song.id}) }}" alt="" width="232" height="232">
            <div class="song-hero-info">
                <span class="eyebrow">{{ 'song.show.eyebrow'|trans }}</span>
                <h1 class="song-title">{{ song.displayTitle }}</h1>
                <p class="song-byline">
                    {% if song.artist %}<a href="{{ path('app_artist', {name: song.artist}) }}">{{ song.artist }}</a>{% endif %}
                    {% if song.album %}<span class="sep">•</span><a href="{{ path('app_album', {name: song.album}) }}">{{ song.album }}</a>{% endif %}
                </p>
                <div class="song-chips">
                    {% if quality %}<span class="quality-badge quality-{{ quality.value }}">{{ quality.label|trans }}</span>{% endif %}
                    {% if song.formatLabel or kbps %}
                        <span class="chip">{{ song.formatLabel }}{% if song.formatLabel and kbps %} · {% endif %}{% if kbps %}{{ 'song.show.kbps'|trans({kbps: kbps}) }}{% endif %}</span>
                    {% endif %}
                    {% if song.genre %}<a class="chip" href="{{ path('app_genre', {name: song.genre}) }}">{{ song.genre }}</a>{% endif %}
                    {% if song.year %}<a class="chip" href="{{ path('app_year', {year: song.year}) }}">{{ song.year }}</a>{% endif %}
                    {% if song.duration %}<span class="chip">{{ '%d:%02d'|format(song.duration // 60, song.duration % 60) }}</span>{% endif %}
                </div>
                <div class="song-actions">
                    <button class="btn" data-play>{{ ui.icon('M8 5v14l11-7z') }} {{ 'common.play'|trans }}</button>
                    {% if app.user %}
                        {# alias must not be "rating": that name is the POPM tag variable used below #}
                        {% import 'partials/_rating.html.twig' as rate %}
                        {{ rate.stars(song, 'song-rate') }}
                        <button class="pill-btn {{ isFavorite ? 'fav-on' }}" data-fav-toggle
                                data-fav-url="{{ path('app_favorite_toggle', {id: song.id}) }}"
                                aria-label="{{ 'song.show.favorite_aria'|trans }}">
                            {{ ui.icon('M12 21s-6.7-4.35-9.33-8.24C.9 10.06 1.4 6.5 4.2 5.2 6.2 4.3 8.6 5 12 8.5 15.4 5 17.8 4.3 19.8 5.2c2.8 1.3 3.3 4.86 1.53 7.56C18.7 16.65 12 21 12 21z') }}
                            <span class="when-off">{{ 'song.show.favorite'|trans }}</span><span class="when-on">{{ 'song.show.favorited'|trans }}</span>
                        </button>
                        <button class="pill-btn {{ isListenLater ? 'll-on' }}" data-ll-toggle
                                data-track-id="{{ song.id }}" aria-label="{{ 'song.show.listen_later'|trans }}">
                            {{ ui.icon('M12 2a10 10 0 100 20 10 10 0 000-20zm1 11H8v-2h3V7h2z') }}
                            <span>{{ 'song.show.listen_later'|trans }}</span>
                        </button>
                        <button class="pill-btn {{ isOffline ? 'off-on' }}" data-off-toggle
                                data-track-id="{{ song.id }}" aria-label="{{ 'song.show.offline_aria'|trans }}">
                            {{ ui.icon('M19.35 10.04A7.49 7.49 0 0012 4a7.5 7.5 0 00-6.96 4.73A6 6 0 006 20h13a5 5 0 00.35-9.96zM12 11l4 4h-3v3h-2v-3H8z') }}
                            <span class="when-off">{{ 'song.show.save_offline'|trans }}</span><span class="when-on">{{ 'song.show.offline'|trans }}</span>
                        </button>
                    {% endif %}
                    {% if song.spotifyUrl %}
                        <a class="pill-btn pill-spotify" href="{{ song.spotifyUrl }}" target="_blank" rel="noopener">
                            {{ ui.icon('M12 2a10 10 0 100 20 10 10 0 000-20zm4.6 14.4a.62.62 0 01-.86.2c-2.35-1.43-5.3-1.76-8.79-.96a.62.62 0 11-.28-1.21c3.81-.87 7.08-.5 9.72 1.11.3.18.39.56.21.86zm1.22-2.72a.78.78 0 01-1.07.26c-2.69-1.65-6.79-2.13-9.97-1.17a.78.78 0 11-.45-1.49c3.63-1.1 8.15-.57 11.24 1.33.37.22.48.7.25 1.07zm.11-2.83C14.7 8.93 9.38 8.75 6.3 9.69a.94.94 0 11-.54-1.79c3.53-1.07 9.4-.86 13.1 1.34a.94.94 0 01-.96 1.61z') }}
                            <span>Spotify</span>
                        </a>
                    {% else %}
                        <a class="pill-btn" href="https://open.spotify.com/search/{{ ((song.artist ?? '') ~ ' ' ~ song.displayTitle)|trim|url_encode }}"
                           target="_blank" rel="noopener" title="{{ 'song.show.spotify_search_title'|trans }}">
                            {{ ui.icon('M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z') }}
                            <span>{{ 'song.show.find_on_spotify'|trans }}</span>
                        </a>
                    {% endif %}
                    {% if isOwner %}
                        <a class="pill-btn" href="{{ path('app_metadata_edit', {id: song.id}) }}">
                            {{ ui.icon('M3 17.25V21h3.75L17.8 9.94l-3.75-3.75zM20.7 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75z') }}
                            <span>{{ 'song.show.edit_metadata'|trans }}</span>
                        </a>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <form method="post" action="{{ path('app_song_ban', {id: song.id}) }}" data-no-nav
                              onsubmit="return confirm('{{ 'song.show.ban_confirm'|trans|e('js') }}')">
                            <input type="hidden" name="_token" value="{{ csrf_token('ban') }}">
                            <button class="pill-btn pill-ban" type="submit" title="{{ 'song.show.ban_title'|trans }}">
                                {{ ui.icon('M12 2a10 10 0 100 20 10 10 0 000-20zM4 12a8 8 0 0112.9-6.3L5.7 16.9A7.9 7.9 0 014 12zm8 8a7.9 7.9 0 01-4.9-1.7L18.3 7.1A8 8 0 0112 20z') }}
                                <span>{{ 'song.show.ban'|trans }}</span>
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </header>

        <div class="song-grid">
            <div class="song-main">
                <section class="panel lyrics">
                    <div class="panel-head"><h2>{{ 'song.show.lyrics'|trans }}</h2></div>
                    {% if song.lyrics %}
                        <div class="lyrics-body">{{ song.lyrics }}</div>
                    {% else %}
                        <p class="muted">{{ 'song.show.no_lyrics'|trans }}</p>
                    {% endif %}
                </section>
            </div>

            <aside class="song-side">
                <section class="panel">
                    <div class="panel-head"><h2>{{ 'song.show.details'|trans }}</h2></div>
                    <dl class="spec-list">
                        {% if quality %}
                            <dt>{{ 'song.show.quality'|trans }}</dt>
                            <dd><span class="quality-badge quality-{{ quality.value }}">{{ quality.label|trans }}</span></dd>
                        {% endif %}
                        {% if song.formatLabel %}
                            <dt>{{ 'song.show.format'|trans }}</dt><dd>{{ song.formatLabel }}</dd>
                        {% endif %}
                        {% if song.audioCodec %}
                            <dt>{{ 'song.show.codec'|trans }}</dt><dd>{{ song.audioCodec }}</dd>
                        {% endif %}
                        {% if kbps %}
                            <dt>{{ 'song.show.bitrate'|trans }}</dt>
                            <dd>{{ 'song.show.kbps'|trans({kbps: kbps}) }}{% if song.bitrateMode %} <span class="muted">{{ song.bitrateMode|upper }}</span>{% endif %}</dd>
                        {% endif %}
                        {% if song.cutoffHz is not null %}
                            {# app:cron:spectrum: where the treble stops; a sharp cutoff too low for the declared bitrate gives the real one. #}
                            <dt>{{ 'song.show.cutoff'|trans }}</dt>
                            <dd>
                                {% if song.cutoffHz > 0 %}{{ 'song.show.khz'|trans({value: (song.cutoffHz / 100)|round / 10}) }}{% else %}<span class="muted">{{ 'song.show.cutoff_failed'|trans }}</span>{% endif %}
                                {% if song.inflated %}<div class="q-inflated-note">{{ 'song.show.inflated'|trans({real: song.effectiveKbps}) }}</div>{% endif %}
                            </dd>
                        {% endif %}
                        {% if song.sampleRate %}
                            <dt>{{ 'song.show.sample_rate'|trans }}</dt>
                            <dd>{{ 'song.show.khz'|trans({value: song.sampleRate / 1000}) }}</dd>
                        {% endif %}
                        {% if song.bitsPerSample and song.lossless %}
                            <dt>{{ 'song.show.bit_depth'|trans }}</dt><dd>{{ 'song.show.bits'|trans({bits: song.bitsPerSample}) }}</dd>
                        {% endif %}
                        {% if song.channels %}
                            <dt>{{ 'song.show.channels'|trans }}</dt>
                            <dd>{{ song.channels == 1 ? 'song.show.mono'|trans : (song.channels == 2 ? 'song.show.stereo'|trans : 'song.show.channels_count'|trans({count: song.channels})) }}</dd>
                        {% endif %}
                        <dt>Spotify</dt>
                        <dd>
                            {% if song.spotifyUrl %}
                                <a class="link" href="{{ song.spotifyUrl }}" target="_blank" rel="noopener" title="{{ song.spotifyUrl }}">open.spotify.com/track/{{ song.spotifyId }} ↗</a>
                            {% elseif song.spotifyCheckedAt %}
                                <span class="muted" title="php bin/console app:cron:spotify-match --retry">{{ 'song.show.spotify_not_found'|trans({date: song.spotifyCheckedAt|format_date('short')}) }}</span>
                            {% else %}
                                <span class="muted" title="php bin/console app:cron:spotify-match --id={{ song.id }}">{{ 'song.show.spotify_not_matched'|trans }}</span>
                            {% endif %}
                        </dd>
                        <dt>{{ 'song.show.rating'|trans }}</dt>
                        <dd title="{{ 'song.show.rating_title'|trans }}">
                            {% if rating %}
                                <span class="stars">{% for i in 1..5 %}{{ i <= rating.stars ? '★' : '☆' }}{% endfor %}</span>
                                <span class="muted">POPM {{ rating.byte }}{% if rating.email %} · {{ rating.email }}{% endif %}</span>
                            {% else %}
                                <span class="muted">{{ 'song.show.not_in_tags'|trans }}</span>
                            {% endif %}
                        </dd>
                        {% if app.user %}
                            <dt>{{ 'song.show.your_plays'|trans }}</dt><dd>{{ playCount }}</dd>
                        {% endif %}
                    </dl>
                </section>

                {% if app.user %}
                    <section class="panel song-audio-settings">
                        <div class="panel-head">
                            <h2>{{ 'song.show.audio_settings'|trans }}</h2>
                            <span class="muted">{{ 'song.show.audio_settings_hint'|trans }}</span>
                        </div>
                        <div class="sas-volume">
                            <label for="sas-volume">{{ 'song.show.volume'|trans }}</label>
                            <input type="range" id="sas-volume" min="0" max="2" step="0.05" value="1">
                            <output id="sas-volume-out" for="sas-volume">1.00</output>
                        </div>
                        <div class="sas-eq" role="group" aria-label="{{ 'song.show.equalizer_aria'|trans }}">
                            {% for band in 0..4 %}
                                <label class="sas-eq-col">
                                    <input type="range" class="sas-eq-band" data-band="{{ band }}" min="-12" max="12" step="1" value="0"
                                           aria-label="{{ 'song.show.band_aria'|trans({n: band + 1}) }}">
                                    <span>{{ band + 1 }}</span>
                                </label>
                            {% endfor %}
                        </div>
                        <div class="sas-buttons">
                            <button type="button" id="sas-save-btn" class="btn">{{ 'common.save'|trans }}</button>
                            <button type="button" id="sas-reset-btn" class="btn btn-ghost">{{ 'common.reset'|trans }}</button>
                            <span id="sas-status" class="muted" role="status"></span>
                        </div>
                    </section>
                {% endif %}
            </aside>
        </div>

        {% include 'partials/_raw_metadata.html.twig' %}

        {% if isOwner %}
            <section class="panel song-versions">
                <div class="panel-head"><h2>{{ 'song.show.file_versions'|trans }}</h2></div>
                {% if versions is empty %}
                    <p class="muted">{{ 'song.show.no_versions'|trans }}</p>
                {% else %}
                    <table class="table">
                        <thead>
                            <tr><th>{{ 'song.show.col_name'|trans }}</th><th>{{ 'song.show.col_date'|trans }}</th><th>{{ 'song.show.col_size'|trans }}</th><th></th></tr>
                        </thead>
                        <tbody>
                            {% for v in versions %}
                                <tr>
                                    <td>{{ v.name }}</td>
                                    <td>{{ v.mtime|format_datetime('short', 'short') }}</td>
                                    <td>{{ 'song.show.size_mb'|trans({size: v.sizeMb}) }}</td>
                                    <td class="table-actions">
                                        <form method="post" action="{{ path('app_song_version_restore', {id: song.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('song_version_restore_' ~ song.id) }}">
                                            <input type="hidden" name="version_name" value="{{ v.name }}">
                                            <button class="btn btn-ghost btn-sm" type="submit">{{ 'song.show.restore'|trans }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}
