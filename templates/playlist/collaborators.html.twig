{% extends 'base.html.twig' %}

{% block title %}{{ 'playlist.collaborators.title'|trans({name: playlist.name}) }}{% endblock %}

{% block body %}
    <div class="toolbar" style="justify-content:space-between;">
        <h1 style="margin:0;">{{ 'playlist.collaborators.title'|trans({name: playlist.name}) }}</h1>
        <a class="btn btn-ghost" href="{{ path('app_playlist_show', {id: playlist.id}) }}">{{ 'playlist.collaborators.back'|trans }}</a>
    </div>

    {% if not playlist.isCollaborative %}
        <p class="muted">{{ 'playlist.collaborators.not_collaborative'|trans }}</p>
    {% endif %}

    <h2>{{ 'playlist.collaborators.current'|trans }}</h2>
    {% if collaborators is empty %}
        <p class="muted">{{ 'playlist.collaborators.empty'|trans }}</p>
    {% else %}
        <div class="track-list">
            {% for c in collaborators %}
                <div class="list-row">
                    <div class="lr-main">{{ c.user.artist }} <span class="lr-sub">({{ c.user.email }})</span></div>
                    <form method="post" action="{{ path('app_playlist_collaborator_remove', {id: playlist.id, userId: c.user.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('playlist_collaborators_' ~ playlist.id) }}">
                        <button class="btn btn-ghost" type="submit">{{ 'common.remove'|trans }}</button>
                    </form>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <h2 style="margin-top:24px;">{{ 'playlist.collaborators.add_heading'|trans }}</h2>
    <form method="post" action="{{ path('app_playlist_collaborator_add', {id: playlist.id}) }}" style="max-width:420px;">
        <input type="hidden" name="_token" value="{{ csrf_token('playlist_collaborators_' ~ playlist.id) }}">
        <div class="field">
            <label for="pl-collab-target">{{ 'playlist.collaborators.target_label'|trans }}</label>
            <input type="text" id="pl-collab-target" name="target" required>
        </div>
        <button class="btn" type="submit">{{ 'common.add'|trans }}</button>
    </form>

    <h2 style="margin-top:24px;">{{ 'playlist.collaborators.invite_heading'|trans }}</h2>
    <p class="section-sub">{{ 'playlist.collaborators.invite_help'|trans }}</p>
    <form method="post" action="{{ path('app_playlist_invite_create', {id: playlist.id}) }}" class="toolbar">
        <input type="hidden" name="_token" value="{{ csrf_token('playlist_collaborators_' ~ playlist.id) }}">
        <label for="pl-invite-expire" class="muted">{{ 'playlist.collaborators.expire_label'|trans }}</label>
        <input type="number" id="pl-invite-expire" name="expire" min="1" style="width:120px;">
        <button class="btn btn-ghost" type="submit">{{ 'playlist.collaborators.generate_link'|trans }}</button>
    </form>
{% endblock %}
