{% extends 'base.html.twig' %}

{% block title %}Playlists · PHP Music{% endblock %}

{% block body %}
    <div class="toolbar" style="justify-content:space-between;">
        <h1 style="margin:0;">Playlists</h1>
        <a class="btn btn-ghost" href="{{ path('app_playlists_collab') }}">Collaborating on…</a>
    </div>

    <form class="toolbar" method="post" action="{{ path('app_playlist_new') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('playlist_new') }}">
        <input class="field search" type="text" name="name" placeholder="New playlist name…" required>
        <input class="field search" type="text" name="description" placeholder="Description (optional)…">
        <label style="display:flex;align-items:center;gap:6px;">
            <input type="checkbox" name="is_private" value="1"> Private
        </label>
        <button class="btn" type="submit">Create</button>
    </form>

    {% if playlists is empty %}
        <p class="muted">You have no playlists yet.</p>
    {% else %}
        <div class="card-grid">
            {% for p in playlists %}
                <a class="card" href="{{ path('app_playlist_show', {id: p.id}) }}">
                    <div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:40px;background:var(--bg-elev-2);border-radius:8px;">🎧</div>
                    <div class="card-title">{{ p.name }}</div>
                    <div class="card-sub">{{ p.items|length }} track{{ p.items|length == 1 ? '' : 's' }}{{ p.isPrivate ? ' · private' }}{{ p.isCollaborative ? ' · collaborative' }}</div>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    <hr style="border-color:var(--border);margin:28px 0;">

    <div style="display:flex;gap:32px;flex-wrap:wrap;">
        <div style="flex:1;min-width:280px;">
            <h2>Copy a playlist</h2>
            <p class="section-sub">Paste the share id (public id) of a public playlist to copy it into your library.</p>
            <form method="post" action="{{ path('app_playlist_copy') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('playlist_copy') }}">
                <div class="field">
                    <input type="text" name="public_id" placeholder="Playlist public id…" required>
                </div>
                <button class="btn" type="submit">Copy</button>
            </form>
        </div>

        <div style="flex:1;min-width:280px;">
            <h2>Import a playlist</h2>
            <p class="section-sub">Upload a JSON export (name + songs) to recreate it in your library.</p>
            <form method="post" action="{{ path('app_playlist_import') }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('playlist_import') }}">
                <div class="field">
                    <input type="file" name="import_file" accept="application/json,.json" required>
                </div>
                <button class="btn" type="submit">Import</button>
            </form>
        </div>
    </div>
{% endblock %}
