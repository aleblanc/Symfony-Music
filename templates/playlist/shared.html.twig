{% extends 'base.html.twig' %}

{% block title %}{{ playlist.name }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ playlist.name }}</h1>
    <p class="section-sub">by {{ playlist.owner.artist }} · {{ playlist.items|length }} track{{ playlist.items|length == 1 ? '' : 's' }}
        {% if playlist.description %}· {{ playlist.description }}{% endif %}</p>

    <form method="post" action="{{ path('app_playlist_copy') }}" style="margin-bottom:20px;">
        <input type="hidden" name="_token" value="{{ csrf_token('playlist_copy') }}">
        <input type="hidden" name="public_id" value="{{ playlist.publicId }}">
        <button class="btn" type="submit">Copy to my playlists</button>
    </form>

    {% if playlist.items is empty %}
        <p class="muted">This playlist is empty.</p>
    {% else %}
        <div class="track-list">
            {% for item in playlist.items %}
                {% set song = item.song %}
                <div class="track" data-track
                     data-track-id="{{ song.id }}"
                     data-track-title="{{ song.displayTitle }}"
                     data-track-artist="{{ song.artist }}"
                     data-track-album="{{ song.album }}"
                     data-track-url="{{ path('app_song', {id: song.id}) }}"
                     data-track-artist-url="{{ song.artist ? path('app_artist', {name: song.artist}) }}"
                     data-track-album-url="{{ song.album ? path('app_album', {name: song.album}) }}"
                     data-track-stream="{{ path('app_stream', {id: song.id}) }}"
                     data-track-cover="{{ path('app_cover', {id: song.id}) }}">
                    <div class="track-lead">
                        <span class="track-idx">{{ loop.index }}</span>
                        <button class="track-play" data-play title="Play" aria-label="Play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button>
                    </div>
                    <img class="track-art" src="{{ path('app_cover', {id: song.id}) }}" alt="" loading="lazy">
                    <div class="track-main">
                        <a class="track-title" href="#" data-play>{{ song.displayTitle }}</a>
                        <div class="track-sub">{{ song.artist }}</div>
                    </div>
                    <div class="track-album">{{ song.album }}</div>
                    <div class="track-dur">{{ song.duration ? '%d:%02d'|format(song.duration // 60, song.duration % 60) : '' }}</div>
                    <div class="track-actions"></div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
