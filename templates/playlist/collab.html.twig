{% extends 'base.html.twig' %}

{% block title %}Collaborating on · PHP Music{% endblock %}

{% block body %}
    <div class="toolbar" style="justify-content:space-between;">
        <h1 style="margin:0;">Collaborating on</h1>
        <a class="btn btn-ghost" href="{{ path('app_playlists') }}">My playlists</a>
    </div>

    {% if playlists is empty %}
        <p class="muted">You are not collaborating on any playlist yet. Ask an owner for an invite link.</p>
    {% else %}
        <div class="card-grid">
            {% for p in playlists %}
                <a class="card" href="{{ path('app_playlist_show', {id: p.id}) }}">
                    <div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:40px;background:var(--bg-elev-2);border-radius:8px;">🎧</div>
                    <div class="card-title">{{ p.name }}</div>
                    <div class="card-sub">by {{ p.owner.artist }} · {{ p.items|length }} track{{ p.items|length == 1 ? '' : 's' }}</div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
