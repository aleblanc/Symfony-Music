{% extends 'base.html.twig' %}

{% block title %}{{ 'playlist.collab.heading'|trans }} · PHP Music{% endblock %}

{% block body %}
    <div class="toolbar" style="justify-content:space-between;">
        <h1 style="margin:0;">{{ 'playlist.collab.heading'|trans }}</h1>
        <a class="btn btn-ghost" href="{{ path('app_playlists') }}">{{ 'playlist.collab.my_playlists'|trans }}</a>
    </div>

    {% if playlists is empty %}
        <p class="muted">{{ 'playlist.collab.empty'|trans }}</p>
    {% else %}
        <div class="card-grid">
            {% for p in playlists %}
                <a class="card" href="{{ path('app_playlist_show', {id: p.id}) }}">
                    <div style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:40px;background:var(--bg-elev-2);border-radius:8px;">🎧</div>
                    <div class="card-title">{{ p.name }}</div>
                    <div class="card-sub">{{ 'playlist.card.by_owner_tracks'|trans({owner: p.owner.artist, count: p.items|length}) }}</div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
