{% extends 'base.html.twig' %}

{% block title %}{{ 'upload.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ 'upload.title'|trans }}</h1>
    <p class="section-sub">{{ 'upload.quota'|trans({quota: quota, limit: limit}) }}</p>

    {% if app.user.verified != 'yes' %}
        <p class="flash flash-error">{{ 'upload.not_verified'|trans }}</p>
    {% endif %}

    <form method="post" action="{{ path('app_upload_submit') }}" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token('upload_song') }}">

        <div class="field">
            <label for="song">{{ 'upload.file'|trans }}</label>
            <input type="file" id="song" name="song" accept=".mp3,.flac,.m4a,.ogg,.wav" required>
            <p class="muted">{{ 'upload.file_help'|trans({mb: (maxUploadBytes / 1024 / 1024)|round}) }}</p>
        </div>

        <div class="field">
            <label for="genre">{{ 'upload.genre'|trans }}</label>
            <input type="text" id="genre" name="genre" maxlength="255">
        </div>

        <div class="field">
            <label><input type="checkbox" name="is_private" value="1"> {{ 'upload.private'|trans }}</label>
        </div>

        <button class="btn" type="submit" {{ app.user.verified != 'yes' or quota <= 0 ? 'disabled' }}>{{ 'common.upload'|trans }}</button>
    </form>
{% endblock %}
