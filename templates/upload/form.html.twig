{% extends 'base.html.twig' %}

{% block title %}Upload a song · PHP Music{% endblock %}

{% block body %}
    <h1>Upload a song</h1>
    <p class="section-sub">{{ quota }} of {{ limit }} uploads remaining today.</p>

    {% if app.user.verified != 'yes' %}
        <p class="flash flash-error">Your account is not verified for uploads yet. Ask an admin to verify your account.</p>
    {% endif %}

    <form method="post" action="{{ path('app_upload_submit') }}" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token('upload_song') }}">

        <div class="field">
            <label for="song">Audio file</label>
            <input type="file" id="song" name="song" accept=".mp3,.flac,.m4a,.ogg,.wav" required>
            <p class="muted">MP3, FLAC, M4A, OGG or WAV. Max {{ (maxUploadBytes / 1024 / 1024)|round }} MB.</p>
        </div>

        <div class="field">
            <label for="genre">Genre (optional, used if the file has no tag)</label>
            <input type="text" id="genre" name="genre" maxlength="255">
        </div>

        <div class="field">
            <label><input type="checkbox" name="is_private" value="1"> Private (only visible to me)</label>
        </div>

        <button class="btn" type="submit" {{ app.user.verified != 'yes' or quota <= 0 ? 'disabled' }}>Upload</button>
    </form>
{% endblock %}
