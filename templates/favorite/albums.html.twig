{% extends 'base.html.twig' %}
{% import 'partials/_disco.html.twig' as disco %}

{% block title %}{{ 'favorite.albums.title'|trans }} · PHP Music{% endblock %}

{% block body %}
    <h1>{{ 'favorite.albums.title'|trans }}</h1>
    <p class="section-sub">
        {{ 'favorite.albums.count'|trans({count: cards|length}) }}
        {%- set owned = cards|filter(c => c.owned)|length %}{% if owned %} · {{ 'favorite.albums.owned'|trans({count: owned}) }}{% endif %}.
        {{ 'favorite.albums.hint_html'|trans|raw }}
    </p>
    {% if cards|length > 1 %}
        <p class="disco-sort">
            {{ 'favorite.albums.sort'|trans }}
            {% if sort == 'popularity' %}<strong>{{ 'favorite.albums.sort_popularity'|trans }}</strong>{% else %}<a class="link" href="{{ path('app_album_favorites') }}">{{ 'favorite.albums.sort_popularity'|trans }}</a>{% endif %}
            ·
            {% if sort == 'added' %}<strong>{{ 'favorite.albums.sort_added'|trans }}</strong>{% else %}<a class="link" href="{{ path('app_album_favorites', {sort: 'added'}) }}">{{ 'favorite.albums.sort_added'|trans }}</a>{% endif %}
            <span class="muted">{{ 'favorite.albums.sort_hint'|trans }}</span>
        </p>
    {% endif %}
    {% if cards is empty %}
        <p class="muted">{{ 'favorite.albums.empty'|trans }}</p>
    {% else %}
        <div class="card-grid">
            {% for d in cards %}
                {{ disco.card(d, loop.index, true) }}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
