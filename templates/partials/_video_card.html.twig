{# One YouTube video: the thumbnail opens YouTube, ▶ plays it here in the lightbox (youtube-nocookie embed, see public/video-lightbox.js). #}
{% macro card(v, isNew, artist = null) %}
    {%- set url = 'https://www.youtube.com/watch?v=' ~ v.id|url_encode -%}
    <div class="video-card">
        <div class="video-thumb">
            <a href="{{ url }}" target="_blank" rel="noopener" tabindex="-1">
                <img src="https://i.ytimg.com/vi/{{ v.id|url_encode }}/mqdefault.jpg" alt="" loading="lazy" referrerpolicy="no-referrer">
            </a>
            {% if isNew %}<span class="badge-new">{{ 'video.new_badge'|trans }}</span>{% endif %}
            <button type="button" class="video-play" data-video-play="{{ v.id }}" data-video-title="{{ v.title }}" title="{{ 'video.play_here'|trans }}" aria-label="{{ 'video.play_aria'|trans({title: v.title}) }}">▶</button>
        </div>
        <a class="video-title" href="{{ url }}" target="_blank" rel="noopener">{{ v.title }}</a>
        <span class="muted video-date">{% if artist %}<a class="link" href="{{ path('app_artist', {name: artist}) }}">{{ artist }}</a> · {% endif %}{{ v.published|format_date('short') }}</span>
    </div>
{% endmacro %}
