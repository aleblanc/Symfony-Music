{#
 # Star rating of a track (Music::$rating, 1 to 5; click the current star
 # again to remove it); saved by player.js through RatingController.
 #}
{% macro stars(song, extraClass = '') %}
    {% set value = song.rating ?? 0 %}
    <span class="rate {{ extraClass }}{{ value ? ' rated' }}" data-rate-url="{{ path('app_rating_set', {id: song.id}) }}" data-stars="{{ value }}"
          role="radiogroup" aria-label="{{ 'common.rating'|trans }}">
        {%- for n in 1..5 -%}
            <button type="button" class="{{ n <= value ? 'on' }}" data-rate="{{ n }}" role="radio" aria-checked="{{ n == value ? 'true' : 'false' }}"
                    title="{{ (n == value ? 'rating.stars_current' : 'rating.stars')|trans({n: n}) }}">★</button>
        {%- endfor -%}
    </span>
{% endmacro %}
