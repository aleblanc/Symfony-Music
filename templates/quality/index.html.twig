{% extends 'base.html.twig' %}

{% block title %}{{ 'quality.index.heading'|trans }} · PHP Music{% endblock %}

{% block body %}
<div class="quality-stats">
    <h1>{{ 'quality.index.heading'|trans }}</h1>
    <p class="section-sub">
        {{ 'quality.index.summary'|trans({count: stats.total}) }}
        {% if stats.unscanned %}<span class="pill-count pill-warn">{{ 'quality.index.unscanned_html'|trans({count: stats.unscanned})|raw }}</span>{% endif %}
    </p>

    <section class="qs-block">
        <h2>{{ 'quality.index.by_quality'|trans }}</h2>
        <div class="qs-stack" role="img" aria-label="{{ 'quality.index.tiers_aria'|trans }}">
            {% for tier in stats.tiers|filter(t => t.count > 0) %}
                <span class="quality-{{ tier.key }}" style="flex: {{ tier.count }}" title="{{ 'quality.index.tier_tooltip'|trans({label: tier.label|trans, count: tier.count, pct: tier.pct}) }}"></span>
            {% endfor %}
        </div>
        <table class="qs-table">
            {% for tier in stats.tiers %}
                <tr>
                    <td><span class="quality-badge quality-{{ tier.key }}">{{ tier.label|trans }}</span></td>
                    <td class="qs-bar-cell"><span class="qs-bar quality-{{ tier.key }}" style="width: {{ tier.pct }}%"></span></td>
                    <td class="qs-num">{{ tier.count }}</td>
                    <td class="qs-num muted">{{ tier.pct }} %</td>
                </tr>
            {% endfor %}
        </table>
        <p class="muted qs-note">
            {{ 'quality.index.bitrate_note'|trans }}
        </p>
        {# app:cron:spectrum: files whose treble cutoff gives away a weaker source than their header says. #}
        <p class="qs-note">
            {% if spectrum.analysed == 0 %}
                <span class="muted">{{ 'quality.index.spectrum_none_html'|trans|raw }}</span>
            {% else %}
                {{ 'quality.index.spectrum_summary'|trans({inflated: spectrum.inflated, analysed: spectrum.analysed, total: spectrum.total}) }}
                {% if spectrum.inflated %}<a class="link" href="{{ path('app_quality_stats', {inflated: 1}) }}#tracks">{{ 'quality.index.spectrum_list'|trans }} →</a>{% endif %}
            {% endif %}
        </p>
    </section>

    {# app:cron:spectrum: where the treble really stops, whatever the header says. #}
    {% if cutoffs.analysed %}
        <section class="qs-block" id="spectrum">
            <h2>{{ 'quality.index.spectrum_heading'|trans }} <span class="muted">{{ 'quality.index.spectrum_sub'|trans({count: cutoffs.analysed, failed: cutoffs.failed, pending: cutoffs.pending}) }}</span></h2>
            <table class="qs-table">
                {% for b in cutoffs.buckets %}
                    <tr>
                        <td>
                            {% if b.count %}
                                <a class="link" href="{{ path('app_quality_stats', {khz_min: b.min, khz_max: b.max}|filter(v => v is not null)) }}#tracks">{{ b.label|trans }}</a>
                            {% else %}
                                <span class="muted">{{ b.label|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="qs-bar-cell"><span class="qs-bar quality-{{ b.quality }}" style="width: {{ b.pct }}%"></span></td>
                        <td class="qs-num">{{ b.count }}</td>
                        <td class="qs-num muted">{{ b.pct }} %</td>
                            <td class="qs-num muted qs-transparent">{% if b.transparent %}<span title="{{ 'quality.index.transparent_title'|trans }}">{{ 'quality.index.transparent_row'|trans({pct: b.transparent}) }}</span>{% endif %}</td>
                    </tr>
                {% endfor %}
            </table>
            <p class="muted qs-note">{{ 'quality.index.transparent_khz'|trans({p90: cutoffs.transparent[90], p99: cutoffs.transparent[99]}) }}</p>
            <p class="muted qs-note">{{ 'quality.index.spectrum_note'|trans }}</p>

            {% if stats.declared|filter(d => d.lower > 0) is not empty %}
                <h3>{{ 'quality.index.declared_heading'|trans }}</h3>
                <table class="qs-table">
                    {% for d in stats.declared %}
                        <tr>
                            <td><span class="quality-badge quality-{{ d.key }}">{{ d.label|trans }}</span></td>
                            <td class="qs-num">{{ d.count }}</td>
                            <td class="qs-declared-real">
                                {% if d.lower %}
                                    {{ 'quality.index.declared_lower'|trans({count: d.lower, pct: (100 * d.lower / d.count)|round(1)}) }}
                                    {% for r in d.real %}<span class="quality-badge quality-{{ r.key }}">{{ r.label|trans }} · {{ r.count }}</span>{% endfor %}
                                {% else %}
                                    <span class="muted">✓ {{ 'quality.index.declared_genuine'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
                <p class="muted qs-note">{{ 'quality.index.declared_note'|trans }}</p>
            {% endif %}
        </section>
    {% endif %}

    <section class="qs-block">
        <h2>{{ 'quality.index.by_format'|trans }}</h2>
        <table class="qs-table">
            {% for f in stats.formats %}
                <tr>
                    <td><a class="link" href="#format-{{ f.key }}">{{ f.label|trans }}</a></td>
                    <td class="qs-bar-cell"><span class="qs-bar" style="width: {{ f.pct }}%"></span></td>
                    <td class="qs-num">{{ f.count }}</td>
                    <td class="qs-num muted">{{ f.pct }} %</td>
                </tr>
            {% endfor %}
        </table>
    </section>

    {% for f in stats.formats %}
        <section class="qs-block" id="format-{{ f.key }}">
            <h2>{{ f.label|trans }} <span class="muted">{{ 'quality.index.format_heading_sub'|trans({count: f.count, lossless: f.lossless ? 'true' : 'false'}) }}</span></h2>
            <table class="qs-table">
                {% for b in f.buckets %}
                    <tr>
                        <td>
                            {% if not f.lossless and b.min is not null %}
                                <a class="link" href="{{ path('app_quality_stats', {format: f.key, min: b.min, max: b.max}|filter(v => v is not null)) }}#tracks">{{ b.label|trans }}</a>
                            {% else %}
                                {{ b.label|trans }}
                            {% endif %}
                        </td>
                        <td class="qs-bar-cell"><span class="qs-bar quality-{{ b.quality ?? 'unknown' }}" style="width: {{ b.pct }}%"></span></td>
                        <td class="qs-num">{{ b.count }}{% if b.inflated %} <a class="q-inflated-note" href="{{ path('app_quality_stats', {inflated: 1}) }}#tracks" title="{{ 'quality.index.bucket_inflated_title'|trans }}">{{ 'quality.index.bucket_inflated'|trans({count: b.inflated}) }}</a>{% endif %}</td>
                        <td class="qs-num muted">{{ b.pct }} %</td>
                        <td class="qs-num muted qs-transparent">{% if b.transparent %}<span title="{{ 'quality.index.transparent_title'|trans }}">{{ 'quality.index.transparent_row'|trans({pct: b.transparent}) }}</span>{% endif %}</td>
                    </tr>
                {% endfor %}
            </table>
            {% if f.transparent %}<p class="muted qs-note">{{ 'quality.index.transparent_kbps'|trans({p90: f.transparent[90], p99: f.transparent[99]}) }}</p>{% endif %}
        </section>
    {% endfor %}

    <section class="qs-block" id="tracks">
        <h2>{{ listTitle|trans }} <span class="muted">{{ 'quality.index.tracks_sub'|trans({count: tracks|length, spotify: tracks|filter(t => t.spotifyId)|length}) }}{% if tracks|length >= listLimit %}{{ 'quality.index.first_n'|trans({limit: listLimit}) }}{% endif %}</span></h2>
        {% if filtered %}<p><a class="link" href="{{ path('app_quality_stats') }}#tracks">{{ 'quality.index.back'|trans }}</a></p>{% endif %}
        {% if tracks is empty %}
            <p class="muted">{{ 'quality.index.empty'|trans }}</p>
        {% else %}
            <table class="qs-tracks">
                <thead><tr><th>{{ 'quality.index.col_bitrate'|trans }}</th><th title="{{ 'quality.index.col_real_title'|trans }}">{{ 'quality.index.col_real'|trans }}</th><th>{{ 'quality.index.col_format'|trans }}</th><th>{{ 'quality.index.col_title'|trans }}</th><th>{{ 'quality.index.col_artist'|trans }}</th><th>{{ 'quality.index.col_album'|trans }}</th><th>{{ 'quality.index.col_spotify'|trans }}</th></tr></thead>
                <tbody>
                    {% for t in tracks %}
                        <tr>
                            <td class="qs-num">
                                {% if t.bitrate %}{{ 'quality.index.kbps'|trans({value: (t.bitrate / 1000)|round}) }}{% if t.bitrateMode %} <span class="muted">{{ t.bitrateMode|upper }}</span>{% endif %}{% else %}?{% endif %}
                                {% if t.declaredQuality %}<span class="quality-badge quality-{{ t.declaredQuality.value }}">{{ t.declaredQuality.label|trans }}</span>{% endif %}
                            </td>
                            {# app:cron:spectrum: an inflated file is judged on its real bitrate (treble cutoff). #}
                            <td class="qs-num">
                                {% if t.effectiveKbps %}
                                    <span class="quality-badge quality-{{ t.quality.value }}">{{ t.quality.label|trans }}</span>
                                    <div class="q-inflated-note">{{ 'quality.index.real_kbps'|trans({value: t.effectiveKbps}) }}{% if t.cutoffHz %} · ↑ {{ 'song.show.khz'|trans({value: (t.cutoffHz / 100)|round / 10}) }}{% endif %}</div>
                                {% elseif t.cutoffHz is null %}
                                    <span class="muted">{{ 'quality.index.not_analysed'|trans }}</span>
                                {% elseif t.cutoffHz == 0 %}
                                    <span class="muted">{{ 'quality.index.not_decodable'|trans }}</span>
                                {% else %}
                                    <span class="muted">✓ {{ 'quality.index.genuine'|trans }} · ↑ {{ 'song.show.khz'|trans({value: (t.cutoffHz / 100)|round / 10}) }}</span>
                                {% endif %}
                            </td>
                            <td>{{ t.formatLabel }}</td>
                            <td><a class="link" href="{{ path('app_song', {id: t.id}) }}">{{ t.title ?: t.file|split('/')|last }}</a></td>
                            <td>{{ t.artist }}</td>
                            <td class="muted">{{ t.album }}</td>
                            <td>{% if t.spotifyId %}<a class="link" href="https://open.spotify.com/track/{{ t.spotifyId }}" target="_blank" rel="noopener" title="open.spotify.com/track/{{ t.spotifyId }}">Spotify ↗</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
</div>
{% endblock %}
