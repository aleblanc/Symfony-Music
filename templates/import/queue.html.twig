{% extends 'base.html.twig' %}

{% block title %}{{ 'import.queue.heading'|trans }} · PHP Music{% endblock %}

{% block body %}
<div class="import-queue" data-import-queue>
    <h1>{{ 'import.queue.heading'|trans }}</h1>
    <p class="section-sub">
        {{ 'import.queue.intro_html'|trans|raw }}
        <span class="import-counts">
            <span class="pill-count">{{ 'import.queue.count_waiting'|trans({count: counts.pending}) }}</span>
            {% if counts.failed %}<span class="pill-count pill-warn">{{ 'import.queue.count_failed'|trans({count: counts.failed}) }}</span>{% endif %}
            {% if counts.unmatched %}<span class="pill-count muted">{{ 'import.queue.count_unmatched'|trans({count: counts.unmatched}) }}</span>{% endif %}
            {% if counts.skipped %}<span class="pill-count muted">{{ 'import.queue.count_skipped'|trans({count: counts.skipped}) }}</span>{% endif %}
            <span class="pill-count muted">{{ 'import.queue.count_imported'|trans({count: counts.imported}) }}</span>
        </span>
    </p>

    {% if item is null %}
        <div class="import-empty">
            <p><strong>{{ 'import.queue.empty_title'|trans }}</strong></p>
            <p class="muted">{{ 'import.queue.empty_help_html'|trans|raw }}</p>
        </div>
    {% else %}
        <section class="import-file">
            <div class="import-file-head">
                <div>
                    <div class="import-file-name">{{ item.originalName }}</div>
                    <div class="muted">{{ folder ?: 'import.queue.folder_root'|trans }}</div>
                </div>
                <div class="import-file-actions">
                    <form method="post" action="{{ path('app_import_skip', {id: item.id}) }}" data-import-skip>
                        <input type="hidden" name="_token" value="{{ csrf_token('import_' ~ item.id) }}">
                        <button class="btn btn-sm btn-ghost" type="submit" title="{{ 'import.queue.skip_title'|trans }}">{{ 'import.queue.skip'|trans }} <kbd>S</kbd></button>
                    </form>
                    <form method="post" action="{{ path('app_import_unclassified', {id: item.id}) }}" data-import-unclassified>
                        <input type="hidden" name="_token" value="{{ csrf_token('import_' ~ item.id) }}">
                        <button class="btn btn-sm btn-ghost" type="submit" title="{{ 'import.queue.unclassified_title'|trans }}">{{ 'import.queue.unclassified'|trans }} <kbd>U</kbd></button>
                    </form>
                    {% if next %}
                        <a class="btn btn-sm btn-ghost" href="{{ path('app_import_queue', {id: next.id}) }}" data-import-next title="{{ 'import.queue.next_title'|trans }}">{{ 'common.next'|trans }} <kbd>N</kbd></a>
                    {% endif %}
                </div>
            </div>

            {% if tags %}
                <audio class="import-audio" controls preload="none" src="{{ path('app_import_audio', {id: item.id}) }}"></audio>
                <dl class="import-tags">
                    <div><dt>{{ 'import.queue.tag_title'|trans }}</dt><dd>{{ tags.title }}</dd></div>
                    <div><dt>{{ 'import.queue.tag_artist'|trans }}</dt><dd>{{ tags.artist ?? '—' }}</dd></div>
                    <div><dt>{{ 'import.queue.tag_album'|trans }}</dt><dd>{{ tags.album ?? '—' }}</dd></div>
                    <div><dt>{{ 'import.queue.tag_length'|trans }}</dt><dd>{{ '%d:%02d'|format(tags.duration // 60, tags.duration % 60) }}</dd></div>
                </dl>
            {% else %}
                <p class="flash flash-error">{{ 'import.queue.file_missing'|trans }}</p>
            {% endif %}

            {% if item.error %}
                <p class="flash flash-error">{{ 'import.queue.last_failed'|trans({error: item.error}) }}</p>
            {% endif %}
        </section>

        <h2 class="import-subtitle">{{ 'import.queue.candidates'|trans }}</h2>
        <div class="import-candidates">
            {% for candidate in candidates %}
                {% set f = candidate.fields %}
                <form class="import-candidate" method="post" action="{{ path('app_import_choose', {id: item.id, index: loop.index0}) }}" data-import-choice="{{ loop.index }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('import_' ~ item.id) }}">
                    <button type="submit" class="import-candidate-button" title="{{ 'import.queue.choose_title'|trans({index: loop.index}) }}">
                        <span class="import-key">{{ loop.index }}</span>
                        {% if candidate.releaseId %}
                            <img class="import-cover" src="https://coverartarchive.org/release/{{ candidate.releaseId }}/front-250" alt="" loading="lazy" width="96" height="96" onerror="this.style.visibility='hidden'">
                        {% else %}
                            <span class="import-cover import-cover-none">♪</span>
                        {% endif %}
                        <span class="import-candidate-text">
                            <strong>{% if f.trackNumber is defined and f.trackNumber %}{{ '%02d'|format(f.trackNumber) }}. {% endif %}{{ f.title ?? '?' }}</strong>
                            <span>{{ f.artist ?? '?' }}</span>
                            <span class="muted">{{ f.album ?? 'import.queue.no_album'|trans }}{% if f.year is defined and f.year %} · {{ f.year }}{% endif %}</span>
                            <span class="import-dest muted" title="{{ 'import.queue.destination_title'|trans }}">→ {{ destinations[loop.index0] }}</span>
                        </span>
                        <span class="import-score {{ candidate.score >= 0.85 ? 'score-high' : (candidate.score >= 0.65 ? 'score-mid' : 'score-low') }}">
                            {{ (candidate.score * 100)|round }}%
                            <small class="muted">{{ candidate.source }}</small>
                        </span>
                    </button>
                    {% if candidate.releaseId %}
                        <a class="import-mb link" href="https://musicbrainz.org/release/{{ candidate.releaseId }}" target="_blank" rel="noopener">MusicBrainz ↗</a>
                    {% endif %}
                </form>
            {% else %}
                <p class="muted">{{ 'import.queue.no_candidate'|trans }}</p>
            {% endfor %}
        </div>
    {% endif %}
</div>

<script>
    // Keyboard: 1-5 choose a candidate, S skip, U unclassified, N next. Installed once:
    // nav.js re-runs page scripts after each partial navigation.
    if (!window.__importQueueKeys) {
        window.__importQueueKeys = true;
        document.addEventListener('keydown', (e) => {
            const page = document.querySelector('[data-import-queue]');
            if (!page || e.ctrlKey || e.metaKey || e.altKey || e.target.closest('input, textarea, select, [contenteditable]')) {
                return;
            }
            const key = e.key.toLowerCase();
            let form = null;
            if (/^[1-9]$/.test(key)) {
                form = page.querySelector('[data-import-choice="' + key + '"]');
            } else if (key === 's') {
                form = page.querySelector('[data-import-skip]');
            } else if (key === 'u') {
                form = page.querySelector('[data-import-unclassified]');
            } else if (key === 'n') {
                const next = page.querySelector('[data-import-next]');
                if (next) { e.preventDefault(); next.click(); }
                return;
            }
            if (form) {
                e.preventDefault();
                form.requestSubmit();
            }
        });
    }
</script>
{% endblock %}
