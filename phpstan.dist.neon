includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: 8
    paths:
        - src/
    # getID3's write modules are require()d at runtime, not autoloaded.
    scanFiles:
        - lib/getid3/write.id3v2.php
        - lib/getid3/module.tag.id3v2.php
    doctrine:
        # Entity association/column properties are typed nullable (?User, ?string)
        # for uninitialized hydration even when the DB column is NOT NULL; this is
        # a deliberate, valid choice, so don't flag it as a mapping mismatch.
        allowNullablePropertyForRequiredField: true
